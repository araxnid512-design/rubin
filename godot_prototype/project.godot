; Engine configuration file.
; Долг: Возрождение — Godot 4.6

config_version=5

[application]

config/name="Долг: Возрождение"
config/description="3D survival-action: восстановление базы группировки «Долг» в Зоне отчуждения."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.04, 0.04, 1)
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

Events="*res://scripts/autoload/events.gd"
ItemDB="*res://scripts/autoload/item_db.gd"
Settings="*res://scripts/autoload/settings.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Quest="*res://scripts/quest/quest.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[navigation]

3d/default_cell_size=0.25
3d/default_cell_height=0.25
world/map_use_async_iterations=false
world/region_use_async_iterations=false

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="allies"
3d_physics/layer_4="enemies"
3d_physics/layer_5="interact"
3d_physics/layer_6="triggers"
3d_physics/layer_7="ground"
3d_physics/layer_8="doors"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=30
common/max_physics_steps_per_frame=4
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=0
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.35, 0.37, 0.36, 1)
limits/opengl/max_lights_per_object=8

[shader_globals]

player_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
power_on={
"type": "float",
"value": 0.0
}
detail_level={
"type": "float",
"value": 1.0
}
wind_time={
"type": "float",
"value": 0.0
}
