{
  "name": "nova",
  "private": true,
  "description": "Nova 2.5D — собственный движок (TypeScript + WebGL2) для 2.5D-игр на телефоне и в браузере",
  "scripts": {
    "build": "esbuild src/demo/main.ts --bundle --format=esm --target=es2020 --outfile=public/game.js",
    "check": "tsc --noEmit",
    "shot": "node tools/shot.mjs"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "typescript": "5.6.3"
  }
}
