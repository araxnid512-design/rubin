-        vec3 dpv = detP(detScale); diffuseColor.rgb *= clamp(1.0 - length(dpv) * detAlb + 0.08, 0.55, 1.1);`)
+        vec3 dpv = detP(detScale); diffuseColor.rgb *= clamp(1.0 - length(dpv) * detAlb + 0.08, 0.55, 1.1);` + cover)
