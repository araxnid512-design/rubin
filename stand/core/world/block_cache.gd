class_name ULBlockCache
extends Resource
## Готовые корпуса санатория (сетки, двери, комнаты, тайники, места врагов, столкновения) и карта расстояний до
## дорог и корпусов — чтобы вход в санаторий не строил всё заново. Пишется --as-test=snbake
## (assets/world/sanatorium_blocks.res). sig — подпись описаний корпусов и версии генератора: не совпала — кэш
## не берётся, корпуса строятся как раньше (медленнее).

@export var sig := 0
@export var rng_state := 0        ## состояние случайности после корпусов (дальше по ней — ограда, деревья…)
@export var blds := {}            ## id корпуса → данные ULBlock.to_cache()
@export var dist: Image           ## R — до края покрытия (−1…4 м), G — до корпуса (0…4 м); шаг 0,25 м
