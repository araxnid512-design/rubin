		["r2_village", -44.0, 0.0, 0.0, 30.0], ["r3_dorm1_in", -58.0, -48.5, 0.0, 12.0], ["r4_dorm2_in", -73.0, 2.0, 0.0, 12.0],
		["r5_canteen_in", -58.0, -22.0, 0.0, 12.0], ["r6_workshop_in", -31.0, -13.0, 0.0, 13.0], ["r7_warehouse_in", -44.0, 23.0, 0.0, 14.0],
		["r8_med_in", -27.0, -48.0, 0.0, 11.0], ["r9_office_in", -62.0, 42.0, 0.0, 12.0], ["t0_dorm1_door", -57.0, -42.0, 0.0, 9.0], ["t1_med_door", -29.5, -43.0, 0.0, 9.0], ["t2_wh_top", -44.0, 25.5, 0.0, 26.0], ["t3_wh_row", -33.5, 22.5, 0.0, 9.0], ["s0_tower", 77.0, -50.0, 0.0, 20.0], ["s1_wall_foot", 45.0, -40.0, 0.0, 12.0]]
	var only := ""
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--as-only="):
			only = a.substr(10)
	if only != "":
		spots = spots.filter(func(sp): return only.split(",").has(String(sp[0])))
	for sp in spots:
		cam_dist = float(sp[4])
		var q := Vector2(float(sp[1]), float(sp[2]))
		var at := Vector3(q.x, ULQuarry.height(q) + float(sp[3]), q.y)
		player.global_position = at + Vector3.UP * 0.1
		player.velocity = Vector3.ZERO
		for e in enemies:
			if e.global_position.distance_to(player.global_position) < 30.0:
				e.state = "idle"
				e.wander_r = 0.0
		_cam_ready = false
		world_env.fog_enabled = not String(sp[0]) in ["q1_wide", "q2_top"]
		await get_tree().create_timer(1.4).timeout
		print("[view] %s: %s, герой (%.1f, %.1f, %.1f)" % [sp[0], _where(), player.global_position.x, player.global_position.y, player.global_position.z])
		await _snap(String(sp[0]))
	# минералы: герой рядом с находкой у жилы или кучи руды (ставится на землю; провалился при переносе — следующая)
	if only == "" or only.split(",").has("m0_minerals"):
		var map := get_world_3d().navigation_map
		for g in ground:
			if String(ULItems.get_def(String(g.item.id)).get("cat", "")) != "mineral":
				continue
			var gp: Vector3 = (g.node as Node3D).global_position
			cam_dist = 9.0
			player.global_position = NavigationServer3D.map_get_closest_point(map, gp + Vector3(1.2, 0, 1.0)) + Vector3.UP * 0.3
			player.velocity = Vector3.ZERO
			_cam_ready = false
			world_env.fog_enabled = true
			await get_tree().create_timer(1.4).timeout
			if player.global_position.y < ULQuarry.height(Vector2(player.global_position.x, player.global_position.z)) - 0.5:
				continue
			print("[view] m0_minerals: находка «%s» в %s, герой %s" % [String(ULItems.get_def(String(g.item.id)).n), str(gp.snapped(Vector3.ONE * 0.1)), str(player.global_position.snapped(Vector3.ONE * 0.1))])
			await _snap("m0_minerals")
			break
	# бой: на посёлковой улице несколько пустышей бегут на героя, он стреляет очередями
	if only == "" or only.split(",").has("c0_combat"):
		cam_dist = 12.0
		var at := Vector3(-44.0, ULQuarry.height(Vector2(-44.0, 4.0)), 4.0)
		player.global_position = at + Vector3.UP * 0.1
		player.rotation.y = 0.0
		var k := 0
		for e in enemies:
			if not e.alive() or String(e.kind) != "infected" or k >= 4:
				continue
			e.global_position = at + Vector3(-2.0 + k * 1.4, 0.05, -5.5 - (k % 2) * 1.2)
			e.state = "chase"
			k += 1
		_cam_ready = false
		world_env.fog_enabled = true
		await get_tree().create_timer(0.8).timeout
		_hud_touch[99] = "fire"
		await get_tree().create_timer(0.9).timeout
		await _snap("c0_combat")
		_hud_touch.erase(99)
		print("[view] c0_combat: пустышей %d" % k)


## «Карьер» (--as-test=qr; --as-reset — проверка перезагрузки кластера): по списку ТЗ — размер и раскладка, глубина
## выработки и спуск по съезду, нет провалов и прохода сквозь скалу, вход во все постройки и скрытие крыш, обыск,
## минералы и хлам, враги 40–60 / 5–12 / 0–1, задание «Последняя смена», таймер 15:00, маршрут, выход с добычей.
func _qr_test() -> void:
	var t0 := Time.get_ticks_msec()
	while not cs_ready and Time.get_ticks_msec() - t0 < 45000:
		await get_tree().process_frame
	var q := san as ULQuarry
	var c := ULQuarry.qcfg()
	var map := get_world_3d().navigation_map
	var snapf := func(p: Vector3) -> Vector3:
		return NavigationServer3D.map_get_closest_point(map, p)
	var space := get_world_3d().direct_space_state
	print("[inv] карьер готов через %.1f с от запуска игры" % (sn_ready_ms / 1000.0))
	var rt_q: Dictionary = ULBase.shop().routes.get("quarry", {})
	_ok("карьер: поле %d × %d м, вход на юго-западе у КПП, %d минут, маршрут %d споранов, опасность «%s»" % [int(size_m), int(size_z), int(c.minutes), int(rt_q.get("price", {}).get("spore", 0)), String(rt_q.get("danger", ""))],
		size_m == 180.0 and size_z == 140.0 and place == "quarry" and ULQuarry.Q_ENTRY.x < -40.0 and ULQuarry.Q_ENTRY.z > 50.0 and int(c.minutes) == 15 and int(rt_q.get("price", {}).get("spore", 0)) == 38 and absf(_cs_end - cs_start - 900.0) < 1.0)
	# 3: глубина и уступы
	var hc := ULQuarry.height(ULQuarry.PIT_C)
	var levels := {}
	for i in 50:
		for j in 24:
			var qq := ULQuarry.pit_point(i / 49.0 * 1.04, j * TAU / 24.0)
			levels[ULQuarry.level_at(qq)] = true
	_ok("выработка настоящей глубины: дно на %.1f м, уступы на −4,5 и −9 м, уровней %d" % [hc, levels.size()], hc < -13.0 and levels.size() == 4)
	# нет дыр: луч сверху в любой точке поля упирается в землю на её высоте
	var holes := 0
	var sampled := 0
	for k in 900:
		var qq := Vector2(randf_range(-ULQuarry.HX + 3.0, ULQuarry.HX - 3.0), randf_range(-ULQuarry.HZ + 3.0, ULQuarry.HZ - 3.0))
		# только ровные места (у стенок сетка шероховатая — там высота по формуле и по сетке расходятся)
		var hq0 := ULQuarry.height(qq)
		var flat := true
		for dq in [Vector2(1, 0), Vector2(-1, 0), Vector2(0, 1), Vector2(0, -1)]:
			if absf(ULQuarry.height(qq + dq) - hq0) > 0.2:
				flat = false
		if not flat:
			continue
		var hit := space.intersect_ray(PhysicsRayQueryParameters3D.create(Vector3(qq.x, 40.0, qq.y), Vector3(qq.x, -40.0, qq.y)))
		sampled += 1
		if hit.is_empty() or (hit.position as Vector3).y < ULQuarry.height(qq) - 0.35:
