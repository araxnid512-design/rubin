func _qr_view() -> void:
	var t0 := Time.get_ticks_msec()
	while not cs_ready and Time.get_ticks_msec() - t0 < 40000:
		await get_tree().process_frame
	var spots := [["q0_entry", -56.0, 58.0, 0.0, 16.0], ["q1_wide", 10.0, -4.0, 0.0, 70.0], ["q2_top", 0.0, 0.0, 0.0, 130.0],
