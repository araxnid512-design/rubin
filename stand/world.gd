				sn.add_child(cn)
				var fit := _fit_model(cn, MODELS + "st_safe.glb", Vector3(SAFE_W, SAFE_H, SAFE_D - 0.04), SAFE_YAW)
				var bb: AABB = fit.aabb
				# задней стенкой — к стене комнаты (1 см зазор)
				var dz := (1.57 - SAFE_Z) - bb.position.z
