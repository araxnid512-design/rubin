var _hud_tex := {}
var _menu_bar: HBoxContainer


func _tex(path: String) -> Texture2D:
	if not _hud_tex.has(path):
		_hud_tex[path] = load(path) if ResourceLoader.exists(path) else null
	return _hud_tex[path]


func _glyph(n: String) -> Texture2D:
	if not _hud_tex.has(n):
		_hud_tex[n] = load("res://assets/icons/hud_%s.png" % n)
	return _hud_tex[n]


func _stat_tex(n: String) -> Texture2D:
	if not _hud_tex.has(n):
		_hud_tex[n] = load("res://assets/icons/%s.png" % n)
	return _hud_tex[n]


func _hud_pos(k: String) -> Vector2:
	var vs := get_viewport().get_visible_rect().size
	var b: Array = HUD_BTNS[k] if HUD_BTNS.has(k) else CAR_BTNS[k]
	if b.size() > 2:
		return (Vector2(0, vs.y) if String(b[2]) == "left" else Vector2(vs.x, 0)) + (b[0] as Vector2)
	return vs + (b[0] as Vector2)


## кнопки машины: руль стрелками, педали и режимы — подписью
func _draw_car_btns() -> void:
	var held: Array = _hud_touch.values()
	for k in CAR_BTNS:
		if not _car_btn_shown(k):
			continue
		var c := _hud_pos(String(k))
		var r: float = CAR_BTNS[k][1]
		var on: bool = held.has(k) or (String(k) == "c_tur" and tur_mode)
		var active := true
		var line := Color(0.6, 0.85, 1.0, 0.75)
		match k:
			"c_gas":
				active = car.can_drive()
				line = Color(0.45, 0.95, 0.5, 0.9 if active else 0.3)
			"c_brake":
				line = Color(1.0, 0.55, 0.4, 0.9)
			"c_rev":
				active = car.can_drive()
				line = Color(1.0, 0.85, 0.4, 0.85 if active else 0.3)
			"c_tur":
				active = car.turret_type() != ""
		_hud.draw_circle(c, r, Color(0.14, 0.32, 0.42, 0.8) if on else Color(0.05, 0.07, 0.09, 0.55 if active else 0.3))
		_hud.draw_arc(c, r, 0, TAU, 44, line, 3.0)
		var ic := Color(1, 1, 1, 0.95 if active else 0.4)
		if k == "c_left" or k == "c_right":
			var s := -1.0 if k == "c_left" else 1.0
			var pts := PackedVector2Array([c + Vector2(s * r * 0.45, 0), c + Vector2(-s * r * 0.3, -r * 0.42), c + Vector2(-s * r * 0.3, r * 0.42)])
			_hud.draw_colored_polygon(pts, ic)
			continue
		if k == "c_tur":
			_hud_text(c + Vector2(0, -8), "Турель", 14, ic)
			_hud_text(c + Vector2(0, 12), "ВКЛ" if tur_mode else "ВЫКЛ", 13, Color(1.0, 0.5, 0.35) if tur_mode else Color(0.7, 0.75, 0.8, ic.a))
			continue
		_hud_text(c + (Vector2(0, -4) if r > 50.0 else Vector2.ZERO), String(CAR_BTN_TXT.get(k, "")), 20 if r > 60.0 else (16 if r > 45.0 else 14), ic)


## значок кнопки из набора пользователя (assets/icons/ui): круглая картинка во всю кнопку
func _art(n: String) -> Texture2D:
	var key := "ui/" + n
	if not _hud_tex.has(key):
		_hud_tex[key] = load("res://assets/icons/ui/%s.png" % n)
	return _hud_tex[key]


func _hud_text(c: Vector2, t: String, fs: int, col := Color(0.95, 0.97, 1.0)) -> void:
	var font := ThemeDB.fallback_font
	var sz := font.get_string_size(t, HORIZONTAL_ALIGNMENT_CENTER, -1, fs)
	_hud.draw_string_outline(font, c + Vector2(-sz.x * 0.5, fs * 0.35), t, HORIZONTAL_ALIGNMENT_CENTER, -1, fs, 5, Color(0, 0, 0, 0.85))
	_hud.draw_string(font, c + Vector2(-sz.x * 0.5, fs * 0.35), t, HORIZONTAL_ALIGNMENT_CENTER, -1, fs, col)


func _hud_icon(tex: Texture2D, c: Vector2, size: float, col := Color.WHITE) -> void:
	if tex:
		_hud.draw_texture_rect(tex, Rect2(c - Vector2.ONE * size * 0.5, Vector2.ONE * size), false, col)


func _draw_hud() -> void:
	var vs := get_viewport().get_visible_rect().size
	# шапка: имя, здоровье, энергия, вода
	var font0 := ThemeDB.fallback_font
	if _hurt_t > 0.0:
		# удар по герою: красные края экрана (середина остаётся видна — куда бежать)
		var ha := 0.5 * clampf(_hurt_t / 0.35, 0.0, 1.0) * clampf(_hurt_amp, 0.6, 1.2)
		var c0 := Color(0.75, 0.03, 0.02, ha)
		var c1 := Color(0.75, 0.03, 0.02, 0.0)
		var bw := vs.x * 0.16
		var bh := vs.y * 0.2
		_hud.draw_polygon(PackedVector2Array([Vector2.ZERO, Vector2(vs.x, 0), Vector2(vs.x - bw, bh), Vector2(bw, bh)]), PackedColorArray([c0, c0, c1, c1]))
		_hud.draw_polygon(PackedVector2Array([Vector2(0, vs.y), Vector2(bw, vs.y - bh), Vector2(vs.x - bw, vs.y - bh), vs]), PackedColorArray([c0, c1, c1, c0]))
		_hud.draw_polygon(PackedVector2Array([Vector2.ZERO, Vector2(bw, bh), Vector2(bw, vs.y - bh), Vector2(0, vs.y)]), PackedColorArray([c0, c1, c1, c0]))
		_hud.draw_polygon(PackedVector2Array([Vector2(vs.x, 0), vs, Vector2(vs.x - bw, vs.y - bh), Vector2(vs.x - bw, bh)]), PackedColorArray([c0, c0, c1, c1]))
	_sense_draw()
	if _dead_t > 0.0:
		_hud.draw_rect(Rect2(Vector2.ZERO, vs), Color(0.1, 0.0, 0.0, 0.6))
		var dt := "Вы погибли"
		var dw := font0.get_string_size(dt, HORIZONTAL_ALIGNMENT_LEFT, -1, 40).x
		_hud.draw_string(font0, Vector2(vs.x * 0.5 - dw * 0.5, vs.y * 0.45), dt, HORIZONTAL_ALIGNMENT_LEFT, -1, 40, Color(1.0, 0.75, 0.6))
	# подложка шапки: тёмная плашка с тонкой рамкой — имя, здоровье и запасы читаются на любой земле
	_hud.draw_rect(Rect2(8, 6, 300, 78), Color(0.03, 0.05, 0.06, 0.5))
	_hud.draw_rect(Rect2(8, 6, 300, 78), Color(0.6, 0.85, 1.0, 0.35), false, 1.5)
	_hud.draw_string_outline(font0, Vector2(18, 30), hero_name, HORIZONTAL_ALIGNMENT_LEFT, -1, 20, 6, Color(0, 0, 0, 0.85))
	_hud.draw_string(font0, Vector2(18, 30), hero_name, HORIZONTAL_ALIGNMENT_LEFT, -1, 20, Color(0.95, 0.97, 1.0))
	# три точки справа от имени — сменить имя
	var dc := _name_dots()
	_hud.draw_circle(dc, 15, Color(0.05, 0.07, 0.09, 0.55))
	_hud.draw_arc(dc, 15, 0, TAU, 28, Color(0.6, 0.85, 1.0, 0.55), 1.5)
	for i in 3:
		_hud.draw_circle(dc + Vector2((i - 1) * 7.0, 0), 2.4, Color(0.92, 0.96, 1.0))
	var bw := 280.0
	_hud.draw_rect(Rect2(16, 39, bw, 12), Color(0, 0, 0, 0.7))
	var hk := clampf(hp / HP_MAX, 0.0, 1.0)
	var hc := Color(0.85, 0.25, 0.22) if hp < 35.0 else Color(0.35, 0.8, 0.3)
	_hud.draw_rect(Rect2(17, 40, (bw - 2) * hk, 10), hc)
	_hud.draw_rect(Rect2(17, 40, (bw - 2) * hk, 3), hc.lightened(0.35))            # блик по верху полоски
	for q4 in 3:
		_hud.draw_rect(Rect2(16 + bw * 0.25 * (q4 + 1), 39, 1.5, 12), Color(0, 0, 0, 0.55))    # деления по четверти
	_hud.draw_rect(Rect2(16, 39, bw, 12), Color(0.8, 0.9, 1.0, 0.5), false, 1.0)
	_hud_text(Vector2(16 + bw - 20, 24), "%d" % int(round(hp)), 18, Color(0.75, 1.0, 0.7))
	var sx := 22.0
	for st in [["stat_en", en, Color(1.0, 0.85, 0.35)], ["stat_water", water, Color(0.45, 0.75, 1.0)]]:
		_hud_icon(_stat_tex(st[0]), Vector2(sx + 8, 68), 20, st[2])
		_hud_text(Vector2(sx + 40, 68), "%d" % int(round(float(st[1]))), 15)
		sx += 84.0
	# спораны — валюта
	_hud_icon(_tex("res://assets/icons/loot_spore.png"), Vector2(sx + 8, 68), 24)
	_hud_text(Vector2(sx + 40, 68), "%d" % inv.count("spore"), 15, Color(0.95, 0.95, 0.9))
	if car_in and car != null:
		# за рулём: прочность УАЗа и скорость
		var cw := 280.0
		var cx := vs.x * 0.5 - cw * 0.5
		var ck := clampf(car.hp() / car.hp_max(), 0.0, 1.0)
		_hud.draw_rect(Rect2(cx, 84, cw, 12), Color(0, 0, 0, 0.6))
		_hud.draw_rect(Rect2(cx + 1, 85, (cw - 2) * ck, 10), Color(0.85, 0.3, 0.2) if ck < 0.3 else Color(0.85, 0.75, 0.35))
		var fk := clampf(car.fuel() / car.tank(), 0.0, 1.0)
		_hud.draw_rect(Rect2(cx, 98, cw, 6), Color(0, 0, 0, 0.6))
		_hud.draw_rect(Rect2(cx + 1, 99, (cw - 2) * fk, 4), Color(0.9, 0.3, 0.2) if fk < 0.15 else Color(0.45, 0.75, 1.0))
		var gear := "R" if car.speed < -0.2 or (car.throttle < 0.0 and absf(car.speed) < 0.3) else ("N" if absf(car.speed) < 0.2 and car.throttle == 0.0 else "D")
		_hud_text(Vector2(vs.x * 0.5, 120), "%s %d / %d · %s %d км/ч · бензин %.1f л" % [car_name(), int(round(car.hp())), int(round(car.hp_max())), gear, int(round(absf(car.speed) * 3.6)), car.fuel()] + ("  — разбита" if car.broken() else ("  — нет бензина" if car.no_fuel() else ("  — двигатель разрушен" if not car.can_drive() else ""))), 15, Color(1.0, 0.92, 0.7))
		if car.turret_type() != "":
			var tst: Dictionary = car.data.turrets.get(car.turret_type(), {})
			_hud_text(Vector2(vs.x * 0.5, 142), "%s · %d / %d%s" % [String(ULCar.turret_cfg(car.turret_type()).n), int(tst.get("ammo", 0)), int(ULCar.turret_cfg(car.turret_type()).cap), "  · ВКЛЮЧЕНА" if tur_mode else "  · выключена"], 14, Color(1.0, 0.75, 0.55) if tur_mode else Color(0.8, 0.85, 0.9))
	# джойстик (за рулём вместо него — кнопки руля)
	if car_in and car != null:
		_draw_car_btns()
	else:
		var jc := _joy_o if _joy_id >= 0 else Vector2(160, vs.y - 160)
		_hud.draw_circle(jc, 92, Color(1, 1, 1, 0.07))
		_hud.draw_arc(jc, 92, 0, TAU, 48, Color(0.6, 0.85, 1.0, 0.45), 2.5)
		_hud.draw_circle(jc + _joy_v * 92, 36, Color(0.6, 0.85, 1.0, 0.5 if _joy_id >= 0 else 0.25))
	var it = inv.get(inv.hand) if inv.hand != "" else null
	var d := ULItems.get_def(String(it.id)) if it != null else {}
	for k in HUD_BTNS:
		var c := _hud_pos(k)
		var r: float = HUD_BTNS[k][1]
		var on: bool = _hud_touch.values().has(k)
		var active := true
		if car_in and k in CAR_HIDE:
			continue                                       # за рулём не стреляют и оружие не меняют
		if k == "sneak" and stealth("enabled", 0.0) <= 0.0:
			continue                                       # скрытность выключена — кнопки нет
		match k:
			"take":
				if _target == null:
					continue                               # рядом ничего нет — кнопки нет
			"heal":
				active = hp < HP_MAX and inv.best_heal(int(HP_MAX - hp)) != ""
			"reload":
				active = it != null and d.has("ammo") and int(it.get("mag", 0)) < int(d.mag) and inv.count(String(d.ammo)) > 0
				if it == null or not d.has("ammo"):
					continue                               # без огнестрела кнопки перезарядки нет
			"map":
				if not map_exists():
					continue                               # у этого места карты нет (полигон)
				active = map_ok()                          # не куплена — кнопка тусклая, с замком
		var line := Color(1.0, 0.8, 0.3, 0.95) if (k == "take" and active) else (Color(1.0, 0.5, 0.4, 0.9) if k == "fire" else Color(0.6, 0.85, 1.0, 0.65 if active else 0.25))
		if k == "reload" and active and int(it.get("mag", 0)) <= 0:
			# магазин пуст — кнопка перезарядки зовёт: красная, «дышит»
			line = Color(1.0, 0.35, 0.3, 0.75 + 0.25 * sin(Time.get_ticks_msec() * 0.01))
		_hud.draw_circle(c, r, Color(0.14, 0.32, 0.42, 0.8) if on else Color(0.05, 0.07, 0.09, 0.55 if active else 0.3))
		_hud.draw_arc(c, r, 0, TAU, 44, line, 3.0 if k == "fire" else 2.5)
		var ic := Color(1, 1, 1, 1.0 if active else 0.4)
		match k:
			"fire":
				var g := "fist"
				if it != null:
					g = "weapon" if String(d.kind) == "melee" else "aim"
				_hud_icon(_art(g), c, r * 2.0, ic)
				if it != null and d.has("ammo"):
					var mag := int(it.get("mag", 0))
					_hud_text(c + Vector2(0, r - 16), "%d / %d" % [mag, inv.count(String(d.ammo))], 16, Color(1.0, 0.45, 0.35) if mag == 0 else Color(1.0, 0.9, 0.6))
			"swap":
				# оружие в руках (или нож из набора, если руки пусты) и стрелки смены
				if it != null:
					_hud_icon(ULItems.icon(String(it.id)), c, r * 1.5)
				else:
					_hud_icon(_art("weapon"), c, r * 2.0, Color(1, 1, 1, 0.75))
				_hud_icon(_glyph("swap"), c + Vector2(r * 0.66, -r * 0.66), 30, Color(1.0, 0.85, 0.4))
			"take":
				# рукопожатие — только у жителя, с которым можно говорить и торговать; у ящика и предмета — их значок
				match String(_target.type):
					"npc":
						_hud_icon(_art("use"), c, r * 2.0, ic)
					"crate", "box", "chest", "car_trunk":
						_hud_icon(_tex("res://assets/icons/crate.png"), c, r * 1.5, ic)
					"car_door", "car_exit", "car_veh":
						_hud_icon(_art("use"), c, r * 2.0, ic)
					"safe":
						_hud_icon(_tex("res://assets/icons/safe.png"), c, r * 1.5, ic)
					"corpse":
						_hud_icon(_tex("res://assets/icons/loot_spore.png"), c, r * 1.4, ic)
					"terminal", "g_term", "g_sel":
						_hud_icon(_art("terminal"), c, r * 2.0, ic)
					"g_fuel", "g_cab", "g_bench":
						_hud_icon(_tex("res://assets/icons/crate.png"), c, r * 1.5, ic)
					_:
						var tid := String(_target.g.item.id)
						_hud_icon(ULItems.icon(tid), c, r * 1.5, ULItems.tint(tid))
				_hud_text(c + Vector2(0, r - 10), _action_label(), 14, Color(1.0, 0.88, 0.55))
			"sneak":
				# глаз: открыт — идёт в рост, перечёркнут — крадётся; подпись — заметили ли героя
				var ec := Color(0.55, 1.0, 0.6) if sneak else Color(1, 1, 1, 0.85)
				_hud.draw_arc(c + Vector2(0, 14), 24, PI * 1.2, PI * 1.8, 16, ec, 3.0)
				_hud.draw_arc(c - Vector2(0, 14), 24, PI * 0.2, PI * 0.8, 16, ec, 3.0)
				_hud.draw_circle(c, 6.0, ec)
				if sneak:
					_hud.draw_line(c + Vector2(-18, 16), c + Vector2(18, -16), ec, 3.0)
					var seen := enemies.any(func(e): return is_instance_valid(e) and e.alive() and not e._calm())
					_hud_text(c + Vector2(0, r + 12), "заметили" if seen else "скрытно", 14, Color(1.0, 0.45, 0.35) if seen else Color(0.6, 1.0, 0.65))
			"heal":
				_hud_icon(_art("heal"), c, r * 2.0, ic)
				var n := inv.count("bandage") + inv.count("medkit")
				_hud_text(c + Vector2(r * 0.72, r * 0.72), str(n), 15)
			"reload":
				_hud_icon(_glyph("reload"), c, 46, ic)
			"inv":
				_hud_icon(_art("bag"), c, r * 2.0, ic)
			"build":
				_hud_icon(_art("build"), c, r * 2.0, ic)
			"menu":
				_hud_icon(_art("menu"), c, r * 2.0, ic)
			"map":
				_hud_map_glyph(c, r, ic, not active)
		_hud.draw_arc(c, r, 0, TAU, 44, line, 3.0 if k == "fire" else 2.5)
	_cs_hud(vs, font0)
	_boss_hud(vs, font0)
	if _leave_t > 0.0:
		var lt := "Вы покидаете локацию: %d" % int(ceil(maxf(LEAVE_S - _leave_t, 0.0)))
		var lw := font0.get_string_size(lt, HORIZONTAL_ALIGNMENT_LEFT, -1, 30).x
		_hud.draw_rect(Rect2(vs.x * 0.5 - lw * 0.5 - 22, 112, lw + 44, 78), Color(0.05, 0.03, 0.02, 0.72))
		_hud.draw_string(font0, Vector2(vs.x * 0.5 - lw * 0.5, 148), lt, HORIZONTAL_ALIGNMENT_LEFT, -1, 30, Color(1.0, 0.7, 0.3))
		var l2 := "вернитесь на локацию, чтобы остаться"
		var lw2 := font0.get_string_size(l2, HORIZONTAL_ALIGNMENT_LEFT, -1, 16).x
		_hud.draw_string(font0, Vector2(vs.x * 0.5 - lw2 * 0.5, 176), l2, HORIZONTAL_ALIGNMENT_LEFT, -1, 16, Color(0.9, 0.88, 0.8))
	# название того, что можно взять, — над кнопкой «взять» (за рулём этой кнопки нет)
	if _target != null and not car_in:
		_hud_text(_hud_pos("take") + Vector2(0, -66), _target_name(), 14, Color(1.0, 0.88, 0.55))


func _hud_hit(p: Vector2) -> String:
	if car_in and car != null:
		for k in CAR_BTNS:
			if _car_btn_shown(k) and p.distance_to(_hud_pos(k)) <= float(CAR_BTNS[k][1]) + 8.0:
				return k
	for k in HUD_BTNS:
		if k == "take" and _target == null:
			continue
		if car_in and k in CAR_HIDE:
			continue
		if k == "sneak" and stealth("enabled", 0.0) <= 0.0:
			continue
		if k == "map" and not map_exists():
			continue
		if p.distance_to(_hud_pos(k)) <= float(HUD_BTNS[k][1]) + 8.0:
			return k
	if p.distance_to(_name_dots()) <= 26.0 or Rect2(10, 4, _name_dots().x + 8, 34).has_point(p):
		return "name"
	# нажатие прямо на подсвеченный предмет — «взять»
	if _target != null and cam != null:
		var at: Vector3 = _target_pos() + Vector3.UP * 0.3
		var xf := get_viewport().get_final_transform()
		if not cam.is_position_behind(at) and cam.unproject_position(at).distance_to(xf * p) <= 70.0 * xf.get_scale().x:
			return "take"
	return ""


func _hud_press(k: String) -> void:
	match k:
		"fire":
			_atk_want = 0.0 if _try_attack() else 0.4
		"take":
			do_action()
		"inv":
			open_inventory()
		"swap":
			cycle_weapon()
		"heal":
			heal()
		"sneak":
			set_sneak(not sneak)
		"reload":
			reload_weapon()
		"build":
			if temp():
				say("Во временном кластере ящик не поставить — он исчезнет вместе с кластером")
			elif place_crate():
				say("Поставлен ящик")
		"menu":
			_menu_bar.visible = not _menu_bar.visible
		"map":
			open_place_map()
		"name":
			open_char_panel()
		"c_exit":
			car_exit()
		"c_veh":
			open_veh_ui()
		"c_tur":
			if car != null and car.turret_type() != "":
				tur_mode = not tur_mode
				say("Турель включена: сама стреляет по врагам ближе 10 м" if tur_mode else "Турель выключена")
			else:
				say("Оружейный модуль не установлен — турель ставится в гараже базы")


# ---------------- карта локации ----------------

## Проверка карты локации (--as-test=pmap --as-place=quarry|home|…): цена — треть маршрута, покупка с маршрутом
## и отдельно, карта живёт вместе с маршрутом, кнопка на локации, метка героя на своём месте, снимок совпадает
## с локацией (не устарел и не перевёрнут).
func _pmap_test() -> void:
	var t0 := Time.get_ticks_msec()
	while temp() and not cs_ready and Time.get_ticks_msec() - t0 < 30000:
		await get_tree().process_frame
	DirAccess.make_dir_recursive_absolute(out)
	for e in enemies:
		e.visible = false
	enemies.clear()
	targets.clear()
	await get_tree().create_timer(1.0).timeout
	# цены и снимки
	var want := {"cowshed": 5, "sanatorium": 13, "convoy": 18, "khutor": 9, "lair": 25, "quarry": 13, "port": 12, "depot": 12}
	var got := {}
	var pics := 0
	for id in want:
		got[id] = int(ULBase.map_price(id).get("spore", 0))
		pics += 1 if ULPlaceMap.exists(id) else 0
	pics += 1 if ULPlaceMap.exists("home") else 0
	_ok("цена карты — треть цены маршрута, до целого: %s" % str(got), got == want)
	_ok("снимки сверху есть для базы и всех шести локаций", pics == 7, "%d из 7" % pics)
	# покупка — на тех трёх маршрутах, что сейчас предлагает компьютер
	ULBase.data.routes.clear()
	(ULBase.data.done as Array).clear()
	var offs: Array = ULBase.offers()
	_ok("компьютер предлагает три маршрута", offs.size() >= 3, str(offs))
	if offs.size() < 3:
		return
	var ra := String(offs[0])
	var rb := String(offs[1])
	var rc := String(offs[2])
	var pa := int(ULBase.shop().routes[ra].price.spore)
	var pb := int(ULBase.shop().routes[rb].price.spore)
	var pc := int(ULBase.shop().routes[rc].price.spore)
	var ma := int(ULBase.map_price(ra).spore)
	var mb := int(ULBase.map_price(rb).spore)
	var mc := int(ULBase.map_price(rc).spore)
	inv.wallet = {"spore": 200}
	var r1 := ULBase.buy_route(inv, ra)
	_ok("маршрут «%s» без карты: списано %d, карты нет" % [ra, pa], r1.ok and int(inv.wallet.spore) == 200 - pa and not ULBase.has_map(ra))
	var r2 := ULBase.buy_map(inv, ra)
	_ok("карту можно докупить к купленному маршруту: ещё %d" % ma, r2.ok and int(inv.wallet.spore) == 200 - pa - ma and ULBase.has_map(ra))
	var r3 := ULBase.buy_map(inv, ra)
	_ok("вторую карту к тому же маршруту не продают", not r3.ok and String(r3.err) == "have" and int(inv.wallet.spore) == 200 - pa - ma)
	var w1 := int(inv.wallet.spore)
	var r4 := ULBase.buy_route(inv, rb, true)
	_ok("маршрут «%s» сразу с картой: %d + %d одним платежом" % [rb, pb, mb], r4.ok and int(inv.wallet.spore) == w1 - pb - mb and ULBase.has_map(rb) and ULBase.route_state(rb) == "bought")
	inv.wallet = {"spore": pc + mc - 1}
	var r5 := ULBase.buy_route(inv, rc, true)
	_ok("на маршрут «%s» с картой (%d + %d) не хватает одного спорана: ничего не списано, маршрут не куплен" % [rc, pc, mc], not r5.ok and String(r5.err) == "money" and int(inv.wallet.spore) == pc + mc - 1 and ULBase.route_state(rc) == "")
	var r6 := ULBase.buy_map(inv, rc)
	_ok("карту без маршрута не купить", not r6.ok and String(r6.err) == "none" and int(inv.wallet.spore) == pc + mc - 1)
	ULBase.set_route(ra, "active")
	_ok("во время посещения карта остаётся при маршруте", ULBase.has_map(ra) and ULBase.route_state(ra) == "active")
	ULBase.set_route(ra, "")
	_ok("посещение окончено — карта ушла вместе с маршрутом", not ULBase.has_map(ra) and ULBase.route_state(ra) == "")
	# на локации
	_ok("у места есть карта, кнопка «Карта» — справа вверху", map_exists() and _hud_hit(_hud_pos("map")) == "map" and _hud_pos("map").x > get_viewport().get_visible_rect().size.x * 0.7 and _hud_pos("map").y < 100.0)
	if temp():
		ULBase.data.routes.erase(place)
		ULBase.set_route(place, "active")
		var op0 := open_place_map()
		_ok("карта не куплена: кнопка с замком, карта не открывается", not map_ok() and not op0 and _map_ui == null)
		if out != "":
			await _snap("pm_locked")
		ULBase.data.routes[place]["map"] = true
	else:
		_ok("на базе карта есть всегда, без покупки", map_ok())
	_hud_press("map")
	await get_tree().process_frame
	await get_tree().process_frame
	_ok("карта открывается кнопкой, игра под ней не принимает касаний", _map_ui != null and is_instance_valid(_map_ui) and _modal())
	if _map_ui == null:
		return
	var mr := _map_ui.map_rect()
	var sp := ULPlaceMap.span(size_m, size_z)
	var ppm := mr.size.x / sp.x
	var vsz := get_viewport().get_visible_rect().size
	_ok("карта целиком на экране, стороны — как у локации (%.0f × %.0f м)" % [sp.x, sp.y], Rect2(Vector2.ZERO, vsz).encloses(mr) and absf(mr.size.x / mr.size.y - sp.x / sp.y) < 0.01 and ppm > 2.0, "точек на метр %.2f" % ppm)
	# метка героя: середина поля — середина карты; восточный и южный края поля — у правого и нижнего краёв карты
	_map_ui.hero_fn = Callable()
	_map_ui.hero = Vector3.ZERO
	var c0 := _map_ui.marker_px()
	_map_ui.hero = Vector3(size_m * 0.5, 0, size_z * 0.5)
	var c1 := _map_ui.marker_px()
	_map_ui.hero = Vector3(-size_m * 0.5, 0, -size_z * 0.5)
	var c2 := _map_ui.marker_px()
	_ok("метка: середина поля — в середине карты, юго-восточный угол поля — справа внизу, северо-западный — слева вверху",
		c0.distance_to(mr.get_center()) < 1.0 and absf(mr.end.x - c1.x - ULPlaceMap.MARGIN * ppm) < 1.0 and absf(mr.end.y - c1.y - ULPlaceMap.MARGIN * ppm) < 1.0
		and absf(c2.x - mr.position.x - ULPlaceMap.MARGIN * ppm) < 1.0 and absf(c2.y - mr.position.y - ULPlaceMap.MARGIN * ppm) < 1.0)
	_map_ui.hero = Vector3(size_m * 2.0, 0, 0)
	_ok("герой за краем карты — метка прижата к краю", absf(_map_ui.marker_px().x - mr.end.x) < 1.0)
	# живая метка идёт за героем: 8 м на восток — на 8 м вправо
	_map_ui.hero_fn = func() -> Array: return [player.global_position, player.rotation.y]
	await get_tree().process_frame
	var p0 := _map_ui.marker_px()
	var w0 := player.global_position
	_ok("метка стоит там, где герой", p0.distance_to(mr.position + ULPlaceMap.to_uv(w0, size_m, size_z) * mr.size) < 1.0)
	if out != "":
		await _snap("pm_map")
	_map_ui.toggle_zoom()
	await get_tree().process_frame
	var vz := _map_ui.view_uv()
	_ok("«Крупнее»: показана часть карты вокруг героя, метка — внутри карты", absf(vz.size.x - 1.0 / ULMapView.ZOOM_K) < 0.001 and vz.position.x >= 0.0 and vz.end.x <= 1.0001 and mr.grow(1.0).has_point(_map_ui.marker_px()))
	if out != "":
		await _snap("pm_zoom")
	_map_ui.toggle_zoom()
	_map_ui.close()
	await get_tree().process_frame
	await get_tree().process_frame
	_ok("«Закрыть» убирает карту, управление возвращается", _map_ui == null and not _modal())
	# снимок совпадает с локацией: свежий вид сверху против запечённого (и против зеркальных — карта не перевёрнута)
	player.visible = false
	for g in ground:
		(g.node as Node3D).visible = false
	var side := maxf(sp.x, sp.y)
	var live: Image = await _top_image(256, side)
	var cw := int(round(256.0 * sp.x / side))
	var ch := int(round(256.0 * sp.y / side))
	live = live.get_region(Rect2i((256 - cw) / 2, (256 - ch) / 2, cw, ch))
	live.resize(48, 48, Image.INTERPOLATE_LANCZOS)
	var baked: Image = (load(ULPlaceMap.path(place)) as Texture2D).get_image()
	if baked.is_compressed():
		baked.decompress()
	baked.resize(48, 48, Image.INTERPOLATE_LANCZOS)
	var sim := {}
	for mode in ["как есть", "зеркало по x", "зеркало по z"]:
		var sa := 0.0
		var sb := 0.0
		var saa := 0.0
		var sbb := 0.0
		var sab := 0.0
		for y in 48:
			for x in 48:
				var a := live.get_pixel(x, y).get_luminance()
				var b := baked.get_pixel(47 - x if mode == "зеркало по x" else x, 47 - y if mode == "зеркало по z" else y).get_luminance()
				sa += a
				sb += b
				saa += a * a
				sbb += b * b
				sab += a * b
		var nn := 48.0 * 48.0
		var den := sqrt(maxf((saa - sa * sa / nn) * (sbb - sb * sb / nn), 1e-9))
		sim[mode] = snappedf((sab - sa * sb / nn) / den, 0.01)
	_ok("снимок на карте совпадает с локацией и не перевёрнут: сходство %s" % str(sim), float(sim["как есть"]) > 0.6 and float(sim["как есть"]) > float(sim["зеркало по x"]) + 0.1 and float(sim["как есть"]) > float(sim["зеркало по z"]) + 0.1)
	print("[inv] итог: ошибок %d" % _fails)

var _map_ui: ULMapView
var _map_free := false               ## проверки: карта доступна без покупки


## есть ли у этого места карта (снимок сверху)
func map_exists() -> bool:
	return not arena and ULPlaceMap.exists(place)


## можно ли её открыть: на базе и в «Тесте уровней» — всегда, во временном кластере — если куплена с маршрутом
func map_ok() -> bool:
	return map_exists() and (not temp() or lvl or _map_free or ULBase.has_map(place))


## значок кнопки: сложенная «гармошкой» карта с меткой; не куплена — с замком
func _hud_map_glyph(c: Vector2, r: float, col: Color, locked: bool) -> void:
	var w := r * 1.16
	var h := r * 0.84
	var top := PackedVector2Array()
	var bot := PackedVector2Array()
	for i in 4:
		var x := c.x - w * 0.5 + w * i / 3.0
		var dy := (-1.0 if i % 2 == 0 else 1.0) * h * 0.11
		top.append(Vector2(x, c.y - h * 0.5 + dy))
		bot.append(Vector2(x, c.y + h * 0.5 + dy))
	for i in 3:
		var shade := Color(0.86, 0.8, 0.6) if i % 2 == 0 else Color(0.68, 0.62, 0.45)
		_hud.draw_colored_polygon(PackedVector2Array([top[i], top[i + 1], bot[i + 1], bot[i]]), Color(shade.r, shade.g, shade.b, col.a))
	var outline := PackedVector2Array([top[0], top[1], top[2], top[3], bot[3], bot[2], bot[1], bot[0], top[0]])
	_hud.draw_polyline(outline, Color(0.12, 0.1, 0.06, col.a), 2.0)
	for i in [1, 2]:
		_hud.draw_line(top[i], bot[i], Color(0.12, 0.1, 0.06, 0.55 * col.a), 1.5)
	var pin := c + Vector2(w * 0.1, -h * 0.02)
	_hud.draw_colored_polygon(PackedVector2Array([pin + Vector2(-5.5, -5), pin + Vector2(5.5, -5), pin + Vector2(0, 7)]), Color(0.85, 0.2, 0.15, col.a))
	_hud.draw_circle(pin + Vector2(0, -6), 6.0, Color(0.85, 0.2, 0.15, col.a))
	_hud.draw_circle(pin + Vector2(0, -6), 2.4, Color(1, 1, 1, col.a))
	if locked:
		var lc := c + Vector2(r * 0.5, r * 0.46)
		_hud.draw_arc(lc + Vector2(0, -5), 5.0, PI, TAU, 12, Color(1.0, 0.85, 0.4), 2.5)
		_hud.draw_rect(Rect2(lc + Vector2(-7.5, -5), Vector2(15, 12)), Color(1.0, 0.85, 0.4))


## открыть карту локации; false — карты нет или она не куплена (тогда — подсказка, где её взять)
func open_place_map() -> bool:
	if not map_exists():
		return false
	if not map_ok():
		say("Карты этой локации нет: её продают в компьютере базы вместе с маршрутом — ещё треть его цены")
		return false
	if _map_ui != null and is_instance_valid(_map_ui):
		return true
	_menu_bar.visible = false
	_joy_id = -1
	_joy_v = Vector2.ZERO
	_hud_touch.clear()
	_map_ui = ULMapView.new()
