func _inv_ids() -> Dictionary:
	var out_d := {}
	for arr in [inv.pockets, inv.pack.items if inv.pack != null else []]:
		for it in arr:
			if it != null:
				out_d[String(it.id)] = int(out_d.get(String(it.id), 0)) + 1
