var tur_mode := false              ## турель включена: сама наводится на ближайшего видимого врага не дальше 10 м и стреляет
var _tur_t: Node3D = null          ## цель турели
var tur_shots := 0
var tur_last := ""                 ## куда попал последний выстрел турели (для проверки)


func _car_btn_shown(_k: String) -> bool:
	return car_in and car != null


## управление машиной: кнопки (пальцы держат), клавиатура (W — газ, S — назад, A/D — руль, пробел — тормоз,
## F — огонь турели), в проверке — автоводитель к точке _auto
func _car_ctrl() -> void:
	var held: Array = _hud_touch.values()
	var gas := held.has("c_gas") or Input.is_physical_key_pressed(KEY_W) or Input.is_physical_key_pressed(KEY_UP)
	var rev := held.has("c_rev") or Input.is_physical_key_pressed(KEY_S) or Input.is_physical_key_pressed(KEY_DOWN)
	var st := 0.0
	if held.has("c_left") or Input.is_physical_key_pressed(KEY_A) or Input.is_physical_key_pressed(KEY_LEFT):
		st += 1.0
	if held.has("c_right") or Input.is_physical_key_pressed(KEY_D) or Input.is_physical_key_pressed(KEY_RIGHT):
		st -= 1.0
	car.brake = held.has("c_brake") or Input.is_physical_key_pressed(KEY_SPACE)
	car.throttle = 1.0 if gas and not rev else (-1.0 if rev and not gas else 0.0)
	car.steer_in = st
	if not _auto.is_empty():
		# автоводитель проверки: руль — на точку, газ — _auto_k
		var lp := car.global_transform.affine_inverse() * (_auto[0] as Vector3)
		car.steer_in = clampf(atan2(lp.x, lp.z) * 2.0, -1.0, 1.0)
		car.throttle = _auto_k
		car.brake = false
	if _modal():
		car.throttle = 0.0
		car.steer_in = 0.0


## кадр за рулём: сбитые заражённые (до шага — иначе тело врага остановило бы машину раньше удара), езда,
## удары о препятствия, звук мотора, турель
func _car_tick(delta: float) -> void:
	_car_ctrl()
	_car_ram(delta)
	car.step(delta)
	if car.crashed > 0.0:
		snd.play("block", car.global_position + Vector3.UP, clampf(-14.0 + car.crashed * 1.5, -14.0, 0.0), 0.1)
		car.crashed = 0.0
	if _car_snd:
		if car.can_drive() and not _car_snd.playing:
			_car_snd.play()
		elif not car.can_drive() and _car_snd.playing:
			_car_snd.stop()
		_car_snd.pitch_scale = 0.75 + absf(car.speed) / maxf(car.vmax(), 1.0) * 0.95
	_turret_tick()


## турель: включена — наводится на ближайшего врага в секторе, не дальше turret_range_max (10 м) и в прямой
## видимости (не за стеной и не за деревом), и, наведясь, сама стреляет в темпе своего оружия
func _turret_tick() -> void:
	var t := car.turret_type()
	if t == "":
		tur_mode = false
		return
	if not tur_mode:
		car.turret_want = 0.0
		return
	var tc := ULCar.turret_cfg(t)
	var rng := minf(float(tc.get("range", 10.0)), ULCar.c("turret_range_max", 10.0))
	var arc := deg_to_rad(ULCar.c("turret_arc_deg", 150.0))
	var cands: Array = []
	var inv_t := car.global_transform.affine_inverse()
	for e in enemies:
		if not is_instance_valid(e) or not e.alive():
			continue
		var d: float = e.global_position.distance_to(car.global_position)
		if d > rng:
			continue
		var lp: Vector3 = inv_t * e.global_position
		if absf(atan2(lp.x, lp.z)) > arc:
			continue
		cands.append([d, e])
	cands.sort_custom(func(a, b): return float(a[0]) < float(b[0]))
	var best: Node3D = null
	for c in cands:
		if _turret_sees(c[1]):
			best = c[1]
			break
	_tur_t = best
	if best == null:
		car.turret_want = 0.0
		return
	car.aim_at(best.global_position)
	# наведена (ствол смотрит на цель) — огонь
	if absf(angle_difference(car.turret_aim, car.turret_want)) < 0.2 and not _modal():
		_turret_shoot()


## цель турели видна: луч от ствола до груди врага ни во что не упирается
func _turret_sees(e: Node3D) -> bool:
	if car.turret_muzzle == null:
		return false
	var from := car.turret_muzzle.global_position
	var q := PhysicsRayQueryParameters3D.create(from, e.global_position + Vector3.UP * 1.0)
	q.exclude = [car.get_rid(), player.get_rid()]
	var h := get_world_3d().direct_space_state.intersect_ray(q)
	return h.is_empty() or h.collider == e or (h.collider is Node and (e as Node).is_ancestor_of(h.collider))


func _turret_shoot() -> void:
	var r := car.turret_fire()
	if r.is_empty():
		return
	if r.has("empty"):
		if Time.get_ticks_msec() * 0.001 - _why_t > 2.0:
			_why_t = Time.get_ticks_msec() * 0.001
			say("Нет боеприпасов для турели — загрузите их в окне «Машина» → «Боеприпасы»")
		return
	if r.has("broken"):
		say("Турель разбита — ремонт в гараже")
		return
	tur_shots += 1
	var tc: Dictionary = r.cfg
	var t := String(r.type)
	var from: Vector3 = r.from
	var dir: Vector3 = r.dir
	if _tur_t != null and is_instance_valid(_tur_t):
		dir = ((_tur_t.global_position + Vector3.UP * 1.0) - from).normalized()
	var sp := deg_to_rad(float(tc.get("spread", 1.0)))
	dir = (dir + Vector3(randf_range(-1, 1), randf_range(-0.3, 0.3), randf_range(-1, 1)) * tan(sp)).normalized()
	var reach := float(tc.get("range", 20.0)) + 1.0
	var q := PhysicsRayQueryParameters3D.create(from, from + dir * reach)
	q.exclude = [car.get_rid(), player.get_rid()]
	var hit := get_world_3d().direct_space_state.intersect_ray(q)
	var end: Vector3 = hit.position if not hit.is_empty() else from + dir * reach
	var col: Object = hit.collider if not hit.is_empty() else null
	tur_last = ("%s@%.1f" % [String((col as Node).name), from.distance_to(end)]) if col is Node else "мимо"
	var look: String = {"rifle": "a545", "mg": "a762x54", "cannon": "veh_shell", "rocket": "veh_rocket"}.get(t, "a545")
	var splash := float(tc.get("splash", 0.0))
	_fly_bullet(look, from, end, null if splash > 0.0 else col, 0.0 if splash > 0.0 else float(tc.dmg))
	if splash > 0.0:
		var bl: Dictionary = _bullets.back()
		bl["splash"] = splash
		bl["sdmg"] = float(tc.dmg)
	for e in enemies:
		e.hear(car.global_position)
	var sname: String = {"rifle": "shot_ak", "mg": "shot_pkp", "cannon": "shot_deagle", "rocket": "grenade_boom"}.get(t, "shot_ak")
	snd.play(sname, from, -2.0 if t != "rocket" else -8.0, 0.05)
	car.turret_effects(t, dir)
	if t == "rocket":
		_rocket_trail(_bullets.back())
	_car_store()


## Ракета турели летит медленнее пули, с огоньком двигателя и дымным следом, который ещё секунду висит в воздухе
func _rocket_trail(bl: Dictionary) -> void:
	var a: Vector3 = bl.a
	var b: Vector3 = bl.b
	var dur := float(bl.dur)
	var root := Node3D.new()
	root.name = "RocketTrail"
	add_child(root)
	root.global_position = a
	if a.distance_to(b) > 0.05:
		root.look_at(b, Vector3.UP if absf((b - a).normalized().y) < 0.98 else Vector3.RIGHT)
	if ResourceLoader.exists(MODELS + "fx_rocket.glb"):
		# своя модель ракеты (Tripo) вместо вытянутой пули
		var rm: Node3D = (load(MODELS + "fx_rocket.glb") as PackedScene).instantiate()
		var rb := _aabb(rm)
		var ln := maxf(rb.size.x, maxf(rb.size.y, rb.size.z))
		rm.scale = Vector3.ONE * (0.9 / maxf(ln, 0.01))
		if rb.size.x >= rb.size.z and rb.size.x >= rb.size.y:
			rm.rotation.y = PI * 0.5                 # длинная ось модели — по направлению полёта (−Z)
		elif rb.size.y > rb.size.z:
			rm.rotation.x = -PI * 0.5
		root.add_child(rm)
		(bl.n as MeshInstance3D).visible = false
	var glow := OmniLight3D.new()
	glow.light_color = Color(1.0, 0.6, 0.25)
	glow.light_energy = 2.0
	glow.omni_range = 3.0
	glow.position = Vector3(0, 0, 0.5)
	root.add_child(glow)
	var tr := CPUParticles3D.new()
	tr.amount = 60
	tr.lifetime = 1.2
	tr.local_coords = false
	tr.position = Vector3(0, 0, 0.5)
	tr.direction = Vector3(0, 0, 1)
	tr.spread = 12.0
	tr.initial_velocity_min = 0.4
	tr.initial_velocity_max = 1.0
	tr.gravity = Vector3(0, 0.5, 0)
	tr.scale_amount_min = 0.5
	tr.scale_amount_max = 1.0
	var curve := Curve.new()
	curve.add_point(Vector2(0, 0.35))
	curve.add_point(Vector2(1, 1.6))
	tr.scale_amount_curve = curve
	var grad := Gradient.new()
	grad.set_color(0, Color(1.0, 0.75, 0.4, 0.9))
	grad.add_point(0.12, Color(0.62, 0.6, 0.57, 0.8))
	grad.set_color(grad.get_point_count() - 1, Color(0.55, 0.55, 0.55, 0.0))
	tr.color_ramp = grad
	var q := QuadMesh.new()
	q.size = Vector2(0.7, 0.7)
	var qm := StandardMaterial3D.new()
	qm.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	qm.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	qm.billboard_mode = BaseMaterial3D.BILLBOARD_PARTICLES
	qm.vertex_color_use_as_albedo = true
	qm.albedo_texture = BCShotFx._blob()
	qm.depth_draw_mode = BaseMaterial3D.DEPTH_DRAW_DISABLED
	q.material = qm
	tr.mesh = q
	tr.emitting = true
	root.add_child(tr)
	var tw := root.create_tween()
	tw.tween_property(root, "global_position", b, dur)
	tw.tween_callback(func() -> void:
		tr.emitting = false
		glow.visible = false
		for c in root.get_children():
			if c is Node3D and c != tr:
				(c as Node3D).visible = false)
	tw.tween_interval(1.3)
	tw.tween_callback(root.queue_free)


## разрыв снаряда турели (автопушка, ракета): огонь и дым, урон врагам в радиусе (меньше к краю, стены закрывают)
func _veh_blast(at: Vector3, r: float, dmg: float) -> void:
	ULGrenade.boom_at(self, at, r)
	snd.play("grenade_boom", at + Vector3.UP * 0.4, 2.0 if r > 2.5 else -2.0, 0.05)
	shake(clampf(1.2 - player.global_position.distance_to(at) * 0.08, 0.2, 1.2), 0.4)
	var space := get_world_3d().direct_space_state
	for e in enemies.duplicate():
		if not is_instance_valid(e) or not e.alive():
			continue
		var d: float = (e.global_position + Vector3.UP * 0.8).distance_to(at)
		if d > r:
			continue
		var q := PhysicsRayQueryParameters3D.create(at + Vector3.UP * 0.4, e.global_position + Vector3.UP * 1.0)
		q.exclude = [car.get_rid() if car != null else RID(), player.get_rid()]
		q.collision_mask = 1
		var h := space.intersect_ray(q)
		if not h.is_empty() and h.collider != e and not (h.collider is CharacterBody3D):
			continue
		_damage(e, dmg * lerpf(1.0, 0.4, clampf(d / maxf(r, 0.1), 0.0, 1.0)), at)


## заражённые на пути машины в этот кадр (кузов, вытянутый по ходу на шаг кадра и ещё 0,8 м)
func _car_ram(delta: float) -> void:
	var sp := absf(car.speed)
	if sp < ULCar.c("ram_min_speed", 3.5):
		return
	var now := Time.get_ticks_msec() * 0.001
	var inv_t := car.global_transform.affine_inverse()
	var reach := sp * delta + 0.8
	var zf := car.size.z * 0.5 + (reach if car.speed > 0.0 else 0.4)
	var zb := -car.size.z * 0.5 - (reach if car.speed < 0.0 else 0.4)
	for e in enemies:
		if not is_instance_valid(e) or not e.alive():
			continue
		var lp: Vector3 = inv_t * e.global_position
		if absf(lp.x) > car.size.x * 0.5 + 0.45 or lp.z > zf or lp.z < zb or lp.y < -1.0 or lp.y > 2.5:
			continue
		if now - float(e.get_meta("car_hit", -9.0)) < 0.6:
			continue
		e.set_meta("car_hit", now)
		var away := e.global_position - car.global_position
		away.y = 0.0
		away = away.normalized() if away.length() > 0.01 else car.fwd()
		var front := lp.z > 0.0
		if e.kind == "ruber":
			# Рубер — как стена: машина встаёт и мнётся
			car.crash(ULCar.c("ruber_car_dmg", 40.0), front)
			car.speed = 0.0
			e.damage(sp * sp * 0.6, car.global_position)
			snd.play("block", e.global_position + Vector3.UP, -2.0)
		else:
			e.damage(sp * sp * ULCar.c("ram_dmg_k", 2.4), car.global_position)
			car.crash(ULCar.c("ram_car_dmg", 2.0), front)
			if e.alive():
				e.global_position += away * 0.8                # выжил — отброшен в сторону
			snd.play("body_fall", e.global_position + Vector3.UP * 0.5, -4.0)
			_blood(e.global_position + Vector3.UP, away, 14)


## сесть за руль (у водительской двери)
func car_enter() -> void:
	if car == null or car_in:
		return
	car_in = true
	tur_mode = false
	_pl_layers = Vector2i(player.collision_layer, player.collision_mask)
	player.collision_layer = 0
	player.collision_mask = 0
	player.visible = false
	player.velocity = Vector3.ZERO
	player.global_position = car.seat_pos()
	_joy_id = -1
	_joy_v = Vector2.ZERO
	snd.play("cover_close", car.door_pos() + Vector3.UP, -6.0)
	if _car_snd and car.can_drive():
		_car_snd.play()
	if car.broken():
		say("Машина разбита — нужен ремонт кузова в гараже базы")
	elif car.no_fuel():
		say("Бак пуст — заправьте машину из канистры (окно «Машина» → «Бак»)")


## выйти: у водительской двери; занято — с другой стороны, сзади, спереди
func car_exit() -> void:
	if car == null or not car_in:
		return
	var spots := [car.door_pos(), car.global_transform * Vector3(-car.size.x * 0.5 - 0.6, 0.0, car.size.z * 0.05), car.trunk_pos(), car.hood_pos()]
	# ещё восемь точек вокруг кузова: на склоне (карьер) и в тесноте первые четыре бывают заняты
	for k in 8:
		var ang := k * TAU / 8.0 + 0.4
		spots.append(car.global_position + Vector3(cos(ang), 0, sin(ang)) * (car.size.z * 0.5 + 0.9))
	var at: Vector3 = spots[0]
	for sp in spots:
		# точка — на землю под ней: машина на склоне стоит с наклоном, её «рядом с дверью» уходит под грунт или над ним
		var gq := PhysicsRayQueryParameters3D.create((sp as Vector3) + Vector3.UP * 1.6, (sp as Vector3) + Vector3.DOWN * 2.6, 1)
		gq.exclude = [car.get_rid(), player.get_rid()]
		var gh := get_world_3d().direct_space_state.intersect_ray(gq)
		var gp: Vector3 = gh.position if not gh.is_empty() else sp
		if _spot_free(gp):
			at = gp
			break
	car_in = false
	tur_mode = false
	car.throttle = 0.0
	car.steer_in = 0.0
	car.brake = true
	car.speed = 0.0
	player.global_position = at + Vector3.UP * 0.1
	player.collision_layer = _pl_layers.x
	player.collision_mask = _pl_layers.y
	player.visible = true
	player.velocity = Vector3.ZERO
	snd.play("cover_open", at + Vector3.UP, -6.0)
	if _car_snd:
		_car_snd.stop()
	_car_store()


