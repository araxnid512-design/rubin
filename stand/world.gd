## экран загрузки уходит, когда локация готова и отрисовалось несколько кадров (не дольше 20 с)
func _cover_wait() -> void:
	var t0 := Time.get_ticks_msec()
	while is_inside_tree() and temp() and not cs_ready and Time.get_ticks_msec() - t0 < 20000:
		await get_tree().process_frame
	if not is_inside_tree():
		return
	for i in 12:
		await get_tree().process_frame
		if not is_inside_tree():
			return
	await get_tree().create_timer(0.5).timeout
	if _leaving or _cover == null or not is_instance_valid(_cover):
		return
	_res_warm = maxf(_res_warm, 2.0)
	ULSettings.step("игра: " + place)
	var bg := _cover.get_node("Bg") as ColorRect
	var c := _cover
	_cover = null
	var tw := create_tween()
	tw.tween_property(bg, "modulate:a", 0.0, 0.35)
	tw.tween_callback(c.queue_free)


## Уход со сцены: экран закрывается, физика тел (падающие враги) сворачивается, кадр — и только потом смена сцены.
## Так движок не разбирает сцену посреди расчёта физики и отрисовки.
func _leave_to(scene: String, why := "") -> void:
	if _leaving:
		return
	_leaving = true
	ULSettings.step(why if why != "" else "уход со сцены " + place)
	_cover_show("Загрузка…")
	for e in enemies:
		if is_instance_valid(e) and e.rig != null and e.rig.ragdoll != null and e.rig.ragdoll.running:
			e.rig.ragdoll.bake()
	set_physics_process(false)
	await get_tree().process_frame
	await get_tree().process_frame
	ULSettings.step("смена сцены после: " + (why if why != "" else place))
	get_tree().change_scene_to_file(scene)


## во временном кластере на диск пишется только то, что при себе; ящики и вещи на базе остаются как были
func _save_carried(path := SAVE, force := false) -> void:
	if (test != "" and not force) or (lvl and not force) or not FileAccess.file_exists(path):
		return
	var d = JSON.parse_string(FileAccess.get_file_as_string(path))
	if not (d is Dictionary):
		return
	d["inv"] = inv.to_dict()
	d["hp"] = hp
	d["en"] = en
	d["water"] = water
	ULBase.write_json(path, d)


func _cs_load() -> void:
	var d = null
	if FileAccess.file_exists(SAVE) and test == "" and not lvl:
		d = JSON.parse_string(FileAccess.get_file_as_string(SAVE))
	if d is Dictionary:
		inv.from_dict(d.get("inv", {}))
		hp = clampf(float(d.get("hp", 65.0)), 1.0, HP_MAX)
		en = clampf(float(d.get("en", 100.0)), 0.0, 100.0)
		water = clampf(float(d.get("water", 100.0)), 0.0, 100.0)
	else:
		# проверки: автомат, пистолет, патроны, бинты, немного ресурсов (рюкзак — малый: больший только у торговца)
		inv.pack = ULItems.make("pack_small")
		inv.primary = ULItems.make("ak74m")
		inv.pistol = ULItems.make("tt")
		inv.hand = "primary"
		for it in [ULItems.make("a545", 90), ULItems.make("a762x25", 32), ULItems.make("bandage", 5)]:
			inv.add(it)
		inv.wallet = {"spore": 12, "pea": 1}
		hp = HP_MAX
	player.global_position = zone_entry() + Vector3(0, 0.1, 0)
	player.rotation.y = zone_entry_yaw()


## таймер кластера сверху посередине: белый, за 2 минуты — оранжевый, последние 30 с — красный и мигает
func _cs_hud(vs: Vector2, font0: Font) -> void:
	if not temp() or _cs_end <= 0.0:
		return
	var left := cs_left()
	var sec := int(ceil(left))
	var t := "%02d:%02d" % [sec / 60, sec % 60]
	var col := Color(0.96, 0.96, 0.92)
	if left <= float(zone_cfg().get("alarm_s", 30)):
		col = Color(1.0, 0.25, 0.2) if int(Time.get_ticks_msec() / 350) % 2 == 0 else Color(1.0, 0.6, 0.5)
	elif left <= 120.0:
		col = Color(1.0, 0.65, 0.25)
	var fs := 34
	var tw := font0.get_string_size(t, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x
	var cap := "до перезагрузки кластера"
	var cw := font0.get_string_size(cap, HORIZONTAL_ALIGNMENT_LEFT, -1, 13).x
	var bw := maxf(tw, cw) + 36.0
	_hud.draw_rect(Rect2(vs.x * 0.5 - bw * 0.5, 8, bw, 62), Color(0.04, 0.03, 0.02, 0.62))
	_hud.draw_rect(Rect2(vs.x * 0.5 - bw * 0.5, 8, bw, 62), col * Color(1, 1, 1, 0.7), false, 1.5)
	_hud.draw_string_outline(font0, Vector2(vs.x * 0.5 - tw * 0.5, 44), t, HORIZONTAL_ALIGNMENT_LEFT, -1, fs, 6, Color(0, 0, 0, 0.8))
	_hud.draw_string(font0, Vector2(vs.x * 0.5 - tw * 0.5, 44), t, HORIZONTAL_ALIGNMENT_LEFT, -1, fs, col)
	_hud.draw_string(font0, Vector2(vs.x * 0.5 - cw * 0.5, 62), cap, HORIZONTAL_ALIGNMENT_LEFT, -1, 13, Color(0.85, 0.85, 0.8))
	# голод заражённых (data/evolve.json): со второй трети времени — «отъедаются», с последней — «звереют»
	var est := evo_stage()
	if est >= 2:
		var et := "заражённые отъедаются" if est == 2 else "заражённые звереют"
		var ec := Color(1.0, 0.72, 0.32) if est == 2 else Color(1.0, 0.38, 0.32)
		# ниже строки сообщений (она — под таймером), на тёмной плашке
		var ew := font0.get_string_size(et, HORIZONTAL_ALIGNMENT_LEFT, -1, 15).x
		_hud.draw_rect(Rect2(vs.x * 0.5 - ew * 0.5 - 10, 100, ew + 20, 21), Color(0.05, 0.03, 0.02, 0.6))
		_hud.draw_string(font0, Vector2(vs.x * 0.5 - ew * 0.5, 116), et, HORIZONTAL_ALIGNMENT_LEFT, -1, 15, ec)
	_quest_hud(vs, font0)


## Главарь в бою: вверху экрана — его имя и широкая полоса здоровья с двумя засечками (границы фаз), справа —
## номер фазы. Убывает с задержкой (светлый след за красной полосой).
var _boss_lag := 1.0
var _boss_cam := Vector3.ZERO      ## сдвиг камеры к главарю в бою с ним


func boss_hud_on() -> bool:
	return boss != null and is_instance_valid(boss) and boss.engaged()


func _boss_hud(vs: Vector2, font0: Font) -> void:
	if not boss_hud_on():
		_boss_lag = 1.0 if boss == null or not is_instance_valid(boss) or not boss.alive() else _boss_lag
		return
	var k := clampf(boss.hp / float(boss.def.hp), 0.0, 1.0)
	_boss_lag = maxf(k, move_toward(_boss_lag, k, get_process_delta_time() * 0.25))
	var w := minf(vs.x * 0.44, 600.0)
	var x := vs.x * 0.5 - w * 0.5
	var y := 132.0
	var nm := String(boss.def.n).to_upper()
	var nw := font0.get_string_size(nm, HORIZONTAL_ALIGNMENT_LEFT, -1, 20).x
	var rage := boss.raging()
	var ncol := Color(1.0, 0.45, 0.3) if rage and int(Time.get_ticks_msec() / 300) % 2 == 0 else Color(1.0, 0.84, 0.72)
	_hud.draw_string_outline(font0, Vector2(vs.x * 0.5 - nw * 0.5, y - 6), nm, HORIZONTAL_ALIGNMENT_LEFT, -1, 20, 7, Color(0, 0, 0, 0.9))
	_hud.draw_string(font0, Vector2(vs.x * 0.5 - nw * 0.5, y - 6), nm, HORIZONTAL_ALIGNMENT_LEFT, -1, 20, ncol)
	_hud.draw_rect(Rect2(x - 3, y - 1, w + 6, 20), Color(0.03, 0.02, 0.02, 0.82))
	_hud.draw_rect(Rect2(x, y + 2, w * _boss_lag, 14), Color(0.95, 0.8, 0.6, 0.75))
	_hud.draw_rect(Rect2(x, y + 2, w * k, 14), Color(0.86, 0.1, 0.07) if not rage else Color(1.0, 0.25, 0.08))
	for th in boss.def.get("phases", []):
		_hud.draw_rect(Rect2(x + w * float(th) - 1.5, y, 3, 18), Color(0.03, 0.02, 0.02, 0.95))
	_hud.draw_rect(Rect2(x - 3, y - 1, w + 6, 20), Color(0.9, 0.7, 0.55, 0.8), false, 1.5)
	var st: String = ["I", "II", "III"][clampi(boss.stage - 1, 0, 2)]
	_hud.draw_string_outline(font0, Vector2(x + w + 12, y + 16), st, HORIZONTAL_ALIGNMENT_LEFT, -1, 20, 6, Color(0, 0, 0, 0.9))
	_hud.draw_string(font0, Vector2(x + w + 12, y + 16), st, HORIZONTAL_ALIGNMENT_LEFT, -1, 20, ncol)


