## каждый кадр: задержки, очередь при удержании, возврат из прицела, доворот к цели
func _combat_tick(delta: float) -> void:
	if car_in:
		_atk_want = 0.0                     # за рулём не стреляют и не бьют (пули турели летят дальше)
		_bullets_tick(delta)
		return
	_atk_cd -= delta                        # в этом кадре может уйти в минус: очередь не теряет выстрелы при низком FPS
	_heal_cd = maxf(0.0, _heal_cd - delta)
	_aim_t += delta
	# отложенное нажатие: пока оружие достаётся, оно ждёт; отсчёт — после попытки атаки этого кадра (ниже), иначе
	# на редких кадрах (кадр длиннее запаса 0,4 с) нажатие сгорало в тот же кадр, когда оружие оказалось в руках
	var atk_wait := rig.hold.wid != "" and rig.hold.drawn < 0.99
	# кнопка удержана — атака повторяется в темпе оружия (и кулаки, и мачете, и одиночный огонь); нажатие чуть
	# раньше срока (оружие ещё достаётся, не кончился прошлый удар) не теряется — сработает, как только можно
	var held: bool = _hud_touch.values().has("fire") or Input.is_physical_key_pressed(KEY_SPACE)
	# Кнопка удержана — оружие стреляет подряд в своём темпе, пока в магазине есть патроны: автомат — очередью,
	# пистолет и дробовик — выстрел за выстрелом. Отпустили — огонь прекращается. Магазин пуст — стрельбы нет,
	# пока не перезарядить (кнопка перезарядки рядом). Кулаки и мачете при удержании бьют подряд.
	var hi = _hand_item()
	var hd := ULItems.get_def(String(hi.id)) if hi != null else {}
	# очередь в темпе оружия, а не кадров: при редких кадрах за кадр уходит несколько выстрелов (не больше трёх)
	for k in 3:
		var repeat: bool = hi == null or String(hd.get("kind", "")) == "melee" or int(hi.get("mag", 0)) > 0
		if not (((held and repeat) or _atk_want > 0.0) and not _modal() and _atk_cd <= 0.0):
			break
		var cd0 := _atk_cd
		attack()
		if _atk_cd == cd0:
			break
		_atk_want = 0.0
	if not atk_wait:
		_atk_want = maxf(0.0, _atk_want - delta)
	_atk_cd = maxf(_atk_cd, 0.0)
	_bullets_tick(delta)
	# метка под целью
	if Engine.get_process_frames() % 4 == 0:
		_mark_t = _attack_target()
	if _mark:
		_mark.visible = false                   # красный круг под целью не рисуется (цель выбирается как прежде)
		if _mark.visible:
			_mark.global_position = (_mark_t as Node3D).global_position + Vector3.UP * 0.05
			_mark.scale = Vector3.ONE * (1.0 + 0.06 * sin(Time.get_ticks_msec() * 0.008))
	# кончил стрелять — оружие сразу опускается из прицела в положение «наготове»
	if not aiming and rig.hold.wid != "" and rig.hold.stance == "aim" and not _reloading:
		rig.hold.set_stance("ready")
	# пистолет на ходу — в опущенной правой руке (рука машет, как у бегущего), а не прижат двумя руками к груди
	if rig.hold.wid != "" and not _reloading and rig.hold.w.stances.has("carry"):
		var going := Vector3(player.velocity.x, 0, player.velocity.z).length() > 0.6 and not aiming
		if rig.hold.stance == "ready" and going:
			rig.hold.set_stance("carry")
		elif rig.hold.stance == "carry" and not going:
			rig.hold.set_stance("ready")
	if not is_nan(_face) and aiming:
		_aim_yaw = _face
		_face = NAN
	if not is_nan(_face):
		player.rotation.y = lerp_angle(player.rotation.y, _face, 1.0 - exp(-delta * 26.0))
		if absf(angle_difference(player.rotation.y, _face)) < 0.03 or _atk_cd <= 0.0:
			_face = NAN


# ---------------- проверка ----------------

func _auto_vec() -> Vector2:
	var p := player.global_position
	var tgt: Vector3 = _auto[0]
	var d := Vector3(tgt.x - p.x, 0, tgt.z - p.z)
	if d.length() < _auto_r:
		_auto.pop_front()
		if _auto.is_empty():
			return Vector2.ZERO
		return _auto_vec()
	var fwd := Vector3(-sin(CAM_YAW), 0, -cos(CAM_YAW))
	var right := Vector3(-fwd.z, 0, fwd.x)
	var dn := d.normalized()
	return Vector2(dn.dot(right), -dn.dot(fwd)) * _auto_k


## замер походки: средняя скорость тела и скольжение стопы, стоящей на земле (носок не выше 3 см над самым
## низким положением два кадра отрисовки подряд), м/с
func _foot_slide(body: CharacterBody3D, sk: Skeleton3D, sec: float) -> Array:
	var prev := {}
	var slide := 0.0
	var slide_n := 0
	var sp := 0.0
	var n := 0
	var t := 0.0
	while t < sec:
		await get_tree().process_frame
		var dt := get_process_delta_time()
		t += dt
		var mv := Vector3(body.velocity.x, 0, body.velocity.z)
		if mv.length() < 0.4:
			prev.clear()
			continue
		sp += mv.length()
		n += 1
		for fn in ["L_ToeBase", "R_ToeBase"]:
			var fp: Vector3 = sk.global_transform * sk.get_bone_global_pose(sk.find_bone(fn)).origin
			var rel_y: float = fp.y - body.global_position.y
			if not prev.has("low") or rel_y < float(prev.low):
				prev["low"] = rel_y
			if prev.has(fn) and dt > 0.0:
				var py: float = (prev[fn] as Vector3).y - float(prev.get("gy", body.global_position.y))
				if rel_y < float(prev.low) + 0.03 and py < float(prev.low) + 0.03:
					var dv: Vector3 = fp - (prev[fn] as Vector3)
					dv.y = 0.0
					slide += dv.length() / dt
					slide_n += 1
			prev[fn] = fp
		prev["gy"] = body.global_position.y
	return [sp / maxf(n, 1), slide / maxf(slide_n, 1)]


## Обзорные снимки отдельной камерой в своё окно отрисовки: без кнопок интерфейса, без ограничения дальности
## прорисовки (она рассчитана на игровую камеру). shots — [имя, где камера, куда смотрит, угол обзора (0 — без
## перспективы, отвесно вниз)]. Дымка остаётся (для вида «как в игре»), кроме снимка без перспективы.
## запечённые тени солнца на земле — когда настоящие тени выключены (качество, подстройка): см. ULSunShadow
func _sun_shadow_apply() -> void:
	_sun_light_apply()
	# --as-nobake — снимки «как было» для сравнения
	# на базе настоящие тени мягче (shadow_opacity 0,7 против 0,78, рассеянного света больше) — и запечённые тоже
	ULSunShadow.apply("" if arena else place, ground_size, sun != null and not sun.shadow_enabled and not OS.get_cmdline_user_args().has("--as-nobake"), 1.0 if temp() else SHADOW_HOME_K)


const SHADOW_HOME_K := 0.72         ## сила запечённой тени на базе (во временных кластерах — 1)
## Солнце без теней. В рендерере телефона (Compatibility) солнце с тенями рисуется отдельным проходом и
## прибавляется к кадру уже в sRGB — кадр выходит в 1,5–1,8 раза ярче, чем то же солнце без теней (там свет
## складывается честно). Вся игра настроена по виду с тенями, поэтому без теней (на «Низкой» и когда подстройка
## их сняла) солнце сильнее и чуть холоднее — подобрано по кадрам (проверка lumtest --as-lumfit): разница с
## кадром «с тенями» в среднем 1–3 % яркости вместо 30–40 %.
const SUN_NOSHADOW_K := 1.9
const SUN_NOSHADOW_K_HOME := 2.2
const SUN_NOSHADOW_TINT := Color(0.95, 1.02, 1.05)
var _sun_e0 := 0.0                   ## сила и цвет солнца по настройке локации (с тенями)
var _sun_c0 := Color.WHITE


func _sun_light_apply() -> void:
	if sun == null or _sun_e0 <= 0.0:
		return
	if sun.shadow_enabled:
		sun.light_energy = _sun_e0
		sun.light_color = _sun_c0
	else:
		# в OpenGL солнце с тенями рисуется доп. проходом и выходит ярче — без теней его усиливаем; в Vulkan
		# такого нет, яркость с тенями и без одинакова сама
		var vk := ULSettings.vulkan()
		sun.light_energy = _sun_e0 * (1.0 if vk else (SUN_NOSHADOW_K if temp() else SUN_NOSHADOW_K_HOME))
		sun.light_color = _sun_c0 * (Color.WHITE if vk else SUN_NOSHADOW_TINT)


const SHADOW_CATCH := """shader_type spatial;
render_mode ambient_light_disabled, specular_disabled, cull_disabled;
// поверхность-«приёмник» для запекания теней: белая там, куда светит солнце, чёрная в тени
void fragment() { ALBEDO = vec3(1.0); ROUGHNESS = 1.0; }
void light() { DIFFUSE_LIGHT += vec3(ATTENUATION); }
"""


## Снимок теней солнца на земле — вид строго сверху на квадрат земли локации: белое — свет, чёрное — тень.
## Всё, что рисуется «земляными» шейдерами (в них есть sun_shade), становится белым приёмником; остальное,
## что отбрасывает тень в игре, остаётся невидимым и только бросает тень; прочее (трава, пятна, туман, герой,
## враги, находки) скрывается. Сцена после этого для игры не годится — только в конце проверки.
func _shadow_mask_image(px: int) -> Image:
	player.visible = false
	for e in enemies:
		e.visible = false
	enemies.clear()
	targets.clear()
	for nb in npcs:
		if nb is Node3D:
			(nb as Node3D).visible = false           # жители дома ходят — их тень не запекается
	for g in ground:
		(g.node as Node3D).visible = false
	var sh := Shader.new()
	sh.code = SHADOW_CATCH
	var cm := ShaderMaterial.new()
	cm.shader = sh
	var recv := 0
	var cast := 0
	var visit := 0
	for n in get_tree().root.find_children("*", "GeometryInstance3D", true, false):
		var gi := n as GeometryInstance3D
		var mat: Material = gi.material_override
		if mat == null and gi is MeshInstance3D and (gi as MeshInstance3D).mesh != null and (gi as MeshInstance3D).mesh.get_surface_count() > 0:
			mat = (gi as MeshInstance3D).mesh.surface_get_material(0)
		if mat is ShaderMaterial and (mat as ShaderMaterial).shader != null and (mat as ShaderMaterial).shader.code.contains("sun_shade("):
			gi.material_override = cm                    # тень отбрасывает как в игре: уступы карьера — да, ровная земля — нет
			recv += 1
		elif gi.cast_shadow == GeometryInstance3D.SHADOW_CASTING_SETTING_OFF:
			gi.visible = false
		elif not _static_geo.is_empty() and not _static_geo.has(gi.get_instance_id()):
			gi.visible = false                           # расставлено случайно в это посещение
			visit += 1
		else:
			gi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_SHADOWS_ONLY
			cast += 1
	sun.shadow_enabled = true
	sun.shadow_blur = 1.6
	world_env.tonemap_mode = Environment.TONE_MAPPER_LINEAR
	world_env.tonemap_exposure = 1.0
	world_env.adjustment_enabled = false
	print("[shadow] приёмников %d, отбрасывают тень %d, случайных предметов посещения скрыто %d, квадрат земли %.0f м" % [recv, cast, visit, ground_size])
	return await _top_image(px, ground_size)


## Снимок локации строго сверху: своё окно отрисовки (без интерфейса), камера без перспективы над серединой
## поля; span — сколько метров в кадре по стороне; верх снимка — «вверх» на экране в игре (−z).
func _top_image(px: int, span: float, center := Vector2.ZERO, frames := 8) -> Image:
	# дальность прорисовки рассчитана на игровую камеру; на общем снимке видно всё
	for n in get_tree().root.find_children("*", "GeometryInstance3D", true, false):
		(n as GeometryInstance3D).visibility_range_end = 0.0
	world_env.fog_enabled = false
	if sun.shadow_enabled:
		sun.directional_shadow_max_distance = span * 2.2
		RenderingServer.directional_shadow_atlas_set_size(8192, true)
	var sv := SubViewport.new()
	sv.size = Vector2i(px, px)
	sv.world_3d = get_viewport().world_3d
	sv.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	sv.msaa_3d = Viewport.MSAA_4X
	sv.mesh_lod_threshold = 0.0
	add_child(sv)
	var tc := Camera3D.new()
	tc.projection = Camera3D.PROJECTION_ORTHOGONAL
	tc.size = span
	tc.near = 1.0
	tc.far = 260.0
	sv.add_child(tc)
	tc.look_at_from_position(Vector3(center.x, 120, center.y), Vector3(center.x, 0, center.y), Vector3(0, 0, -1))
	tc.current = true
	for i in frames:
		await get_tree().process_frame
	await RenderingServer.frame_post_draw
	var img := sv.get_texture().get_image()
	sv.queue_free()
	return img


const GROUND_WHITE := """shader_type spatial;
render_mode cull_disabled;
// белая матовая поверхность на месте земли: на снимке остаётся один только свет (для запекания земли)
void fragment() { ALBEDO = vec3(1.0); ROUGHNESS = 1.0; SPECULAR = 0.0; }
"""


## Запекание земли (ULGroundBake), снимки поля строго сверху; всё, кроме земли, скрыто:
##   wgt — раскладка слоёв (плитками tiles × tiles по px точек): подробный шейдер вместо цвета выдаёт веса слоёв;
##   lit — земля как в игре, но без теней, дымки и цветокоррекции (один снимок lpx точек);
##   white — то же поле с белой матовой землёй: один только свет;
##   fast0 — быстрая земля без поправки тона (снимается, когда раскладка уже лежит в проекте — второй запуск).
## По ним tools/ground_post.py делает раскладку и тон. Сцена после этого для игры не годится.
func _ground_bake(dir: String, px: int, tiles: int, lpx: int) -> void:
	player.visible = false
	for e in enemies:
		e.visible = false
	enemies.clear()
	targets.clear()
	_ground_apply(false)
	var grounds: Array[GeometryInstance3D] = []
	var own := {}
	for n in get_tree().root.find_children("*", "GeometryInstance3D", true, false):
		var gi := n as GeometryInstance3D
		if gi.material_override is ShaderMaterial and ground_mats.has(gi.material_override):
			grounds.append(gi)
			own[gi] = gi.material_override
		else:
			gi.visible = false
	sun.shadow_enabled = false
	RenderingServer.global_shader_parameter_set(&"sun_shadow_k", 0.0)
	world_env.tonemap_mode = Environment.TONE_MAPPER_LINEAR
	world_env.tonemap_exposure = 0.5                     # свет в сумме больше единицы — без запаса снимок «выгорит»
	world_env.adjustment_enabled = false
	print("[ground] сеток земли %d, квадрат %.0f м, раскладка %d×%d плиток по %d точек, тон %d точек" % [grounds.size(), ground_size, tiles, tiles, px, lpx])
	# раскладка: тот же шейдер, но наружу — веса слоёв (трава, подстилка, тропа), без света
	for g in grounds:
		var src: ShaderMaterial = own[g]
		var code: String = (src.get_meta("full") as Shader).code
		var wcode := code.replace("shader_type spatial;\n", "shader_type spatial;\nrender_mode unshaded;\n").replace("\tALBEDO = c * bright * m.a * 0.92;", "\tALBEDO = vec3(b.x, b.y, b.w);")
		if wcode.length() == code.length() or not wcode.contains("vec3(b.x, b.y, b.w)"):
			push_error("шейдер земли изменился: веса слоёв снять не удалось")
		var wsh := Shader.new()
		wsh.code = wcode
		var wm := src.duplicate() as ShaderMaterial
		wm.shader = wsh
		g.material_override = wm
	for ty in tiles:
		for tx in tiles:
			var ts := ground_size / float(tiles)
			var c := Vector2((float(tx) + 0.5) * ts - ground_size * 0.5, (float(ty) + 0.5) * ts - ground_size * 0.5)
			(await _top_image(px, ts, c, 3)).save_png("%s/ground_%s_wgt_%d_%d.png" % [dir, place, tx, ty])
	for g in grounds:
		g.material_override = own[g]
	(await _top_image(lpx, ground_size, Vector2.ZERO, 3)).save_png("%s/ground_%s_lit.png" % [dir, place])
	var whs := Shader.new()
	whs.code = GROUND_WHITE
	var whm := ShaderMaterial.new()
	whm.shader = whs
	for g in grounds:
		g.material_override = whm
	(await _top_image(lpx, ground_size, Vector2.ZERO, 3)).save_png("%s/ground_%s_white.png" % [dir, place])
	if ResourceLoader.exists(ULGroundBake.path_w(place)):
		for g in grounds:
			var sm: ShaderMaterial = own[g]
			g.material_override = sm
			sm.shader = ULGroundBake.shader(bool(sm.get_meta("cut", false)))
			sm.set_shader_parameter("wmap", load(ULGroundBake.path_w(place)))
			sm.set_shader_parameter("tint", ULGroundBake.white())
			sm.set_shader_parameter("tone_k", 1.0)
		(await _top_image(lpx, ground_size, Vector2.ZERO, 3)).save_png("%s/ground_%s_fast0.png" % [dir, place])
		if ULGroundBake.exists(place):
			# сверка готового: быстрая земля с тоном — должна совпасть со снимком lit
			for g in grounds:
				(own[g] as ShaderMaterial).set_shader_parameter("tint", load(ULGroundBake.path_t(place)))
				(own[g] as ShaderMaterial).set_shader_parameter("tone_k", ULGroundBake.TONE_MAX)
			(await _top_image(lpx, ground_size, Vector2.ZERO, 3)).save_png("%s/ground_%s_fast.png" % [dir, place])


func _pano(shots: Array, px: Vector2i) -> void:
	await get_tree().create_timer(1.0).timeout
	for n in get_tree().root.find_children("*", "GeometryInstance3D", true, false):
		(n as GeometryInstance3D).visibility_range_end = 0.0
	if sun.shadow_enabled:
		sun.directional_shadow_max_distance = 320.0
		RenderingServer.directional_shadow_atlas_set_size(8192, true)
	var sv := SubViewport.new()
	sv.size = px
	sv.world_3d = get_viewport().world_3d
	sv.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	sv.msaa_3d = Viewport.MSAA_4X
	sv.mesh_lod_threshold = 0.0
	add_child(sv)
	var tc := Camera3D.new()
	tc.near = 1.0
	tc.far = 1500.0
	sv.add_child(tc)
	tc.current = true
	# у игровой камеры горизонта в кадре нет (фон — ровный цвет); у обзорной — есть: небо из тех же настроек
	var bg0 := world_env.background_mode
	var fsa0 := world_env.fog_sky_affect
	world_env.background_mode = Environment.BG_SKY
	world_env.fog_sky_affect = 0.55
	var fog0 := world_env.fog_enabled
	var fb0 := world_env.fog_depth_begin
	var fe0 := world_env.fog_depth_end
	for sp in shots:
		var ortho := float(sp[3]) <= 0.0
		if ortho:
			tc.projection = Camera3D.PROJECTION_ORTHOGONAL
			tc.size = maxf(size_m, size_z) + 8.0
			tc.look_at_from_position(sp[1], sp[2], Vector3(0, 0, -1))
			world_env.fog_enabled = false
		else:
			tc.projection = Camera3D.PROJECTION_PERSPECTIVE
			tc.fov = float(sp[3])
			tc.look_at_from_position(sp[1], sp[2], Vector3.UP)
			# дымка игры рассчитана на камеру в 12 м от героя; для обзора с высоты — та же густота на своём расстоянии
			world_env.fog_enabled = fog0
			var dist := (sp[1] as Vector3).distance_to(sp[2])
			world_env.fog_depth_begin = dist * 0.75
			world_env.fog_depth_end = dist * 3.2
		for i in 6:
			await get_tree().process_frame
		await RenderingServer.frame_post_draw
		sv.get_texture().get_image().save_png("%s/%s.png" % [out, String(sp[0])])
		print("[pano] %s" % String(sp[0]))
	world_env.fog_enabled = fog0
	world_env.fog_depth_begin = fb0
	world_env.fog_depth_end = fe0
	world_env.background_mode = bg0
	world_env.fog_sky_affect = fsa0
	sv.queue_free()


func _snap(name: String) -> void:
	if DisplayServer.get_name() == "headless":
		return                                  # без экрана снимка нет (и кадр отрисовки не наступит)
	await RenderingServer.frame_post_draw
	get_viewport().get_texture().get_image().save_png("%s/%s.png" % [out, name])


func _walk(points: Array, limit := 30.0) -> void:
	_auto = points.duplicate()
	# предел — в игровом времени (кадры физики): при медленной отрисовке игра идёт медленнее часов, и по часам
	# герой «не успевал» дойти, хотя шёл правильно; по часам — только запас от зависания
	var f0 := Engine.get_physics_frames()
	var t0 := Time.get_ticks_msec()
	while not _auto.is_empty() and _game_s(f0) < limit and Time.get_ticks_msec() - t0 < int(limit * 8000.0):
		await get_tree().process_frame
	_auto.clear()
	await get_tree().create_timer(0.5).timeout


## сколько секунд игрового времени прошло с кадра физики f0
func _game_s(f0: int) -> float:
	return float(Engine.get_physics_frames() - f0) / float(Engine.physics_ticks_per_second)


