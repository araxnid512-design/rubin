func do_action() -> void:
	if _target == null:
		return
	if _target.type == "car_door":
		car_enter()
		return
	if _target.type == "car_exit":
		car_exit()
		return
	if _target.type == "car_trunk":
		open_trunk()
		return
	if _target.type == "car_veh":
		open_veh_ui("ammo")
		return
	if String(_target.type).begins_with("g_"):
		open_garage_ui(String(_target.type))
		return
	if _target.type == "crate":
		open_inventory(_target.c.get_meta("items"), "Ящик", false, "crate")
		snd.play("hit_wood", (_target.c as Node3D).global_position, -10.0)
		return
	if _target.type == "npc":
		open_talk(_target.n)
		return
	if _target.type == "terminal":
		open_terminal()
		return
	if _target.type == "safe":
		open_safe(int(_target.k))
		return
	if _target.type == "chest":
		open_chest()
		return
	if _target.type == "box":
		# тайник в корпусе: его содержимое — как хранилище (взять всё или по одному)
		var ct: Dictionary = san.containers[int(_target.i)]
		if ct.has("need"):
			# запертый тайник задания (контейнер ТК-417): без документов не открыть; открыт — отметка этапа
			if inv.count(String(ct.need)) <= 0 and not bool(ct.get("opened", false)):
				say(String(ct.get("need_text", "Заперто")))
				snd.play("block", ct.pos, -8.0)
				return
			if quest.is_empty():
				quest = {"found": {}, "done": false}
			var qflag := String(ct.get("flag", "p_box"))
			if not (quest.found as Dictionary).has(qflag):
				quest.found[qflag] = true
				say("Задание «%s»: %s" % [String(quest_cfg().get("n", "")), String(ct.get("open_text", "контейнер найден и открыт"))])
		var ic := {"med": "kit_6", "kitchen": "kit_9", "locker": "ammo_1", "bedside": "kit_7", "mil_med": "kit_6", "mil_ammo": "ammo_3", "soldier": "ammo_3",
			"truck": "ammo_5", "btr": "ammo_5", "soldier_bag": "kit_9", "cab": "kit_9", "fuel": "junk", "wreck": "junk"}.get(String(ct.kind), "crate")
		inv_ui.auto_close = "stash"              # «Взять всё» из тайника — и окно закрывается само
		open_inventory(ct.items, String(ct.n), false, ic)
		snd.play("hit_wood" if String(ct.kind) in ["bedside", "wardrobe", "desk", "store", "reception", "workbench", "mil_ammo", "mil_gear", "mil_docs"] else ("cloth" if String(ct.kind) in ["soldier", "soldier_bag", "mil_med"] else "click"), ct.pos, -12.0)
		ct["opened"] = true
		return
	if _target.type == "corpse":
		# обыск тела: его добыча — как хранилище; что взять — решает игрок («Взять всё» или по одному).
		# Пустое тело окна не открывает — сразу «Пусто»; забрали всё — окно закрывается само (_on_loot_emptied):
		# как в Last Day on Earth и Dawn of Zombies, на пустое окно время не тратится.
		var ce := _target.e as ULEnemy
		if loot_empty(ce.loot):
			ce.set_meta("looted", true)
			_target = null
			say("Пусто")
			snd.play("cloth", ce.body_pos(), -10.0)
			return
		_open_corpse = ce
		inv_ui.auto_close = "body"
		open_inventory(ce.loot, String(ce.def.n), false, String(ce.def.pic))
		return
	var g: Dictionary = _target.g
	var it: Dictionary = g.item
	if ULItems.kind(it) == "pack":
		_open_ground = g
		open_inventory(it.items, ULItems.get_def(String(it.id)).n, true, String(it.id))
		return
	var n0 := int(it.n)
	var left := inv.add(it)
	if left == n0:
		say("Нет места")
		return
	snd.play("cloth", (g.node as Node3D).global_position, -6.0)
	if left == 0:
		_remove_ground(g)
		say("Подобрано: " + ULItems.get_def(String(it.id)).n)
	else:
		say("Взято не всё — нет места")
	# оружие легло в пустой слот и в руках ничего — сразу в руки
	var sl := ULItems.slot_of(it)
	if inv.hand == "" and sl in ["pistol", "primary"] and inv.get(sl) == it:
		inv.hand = sl
	_apply_gear()
	_save()


