## вход: отсчёт времени, останки коров и враги — по случайности этого посещения (каждый вход — по-новому)
func _cowshed_enter() -> void:
	var c := zone_cfg()
	# Возвращение: посещение этой локации уже идёт (маршрут хранит срок перезагрузки кластера и случайность) —
	# срок прежний, всё расставляется по той же случайности, а затем приводится к тому, как было оставлено.
	var track := (test == "" or test == "revisit") and not lvl
	var vst := {}
	if track and ULBase.route_left(place) > 0:
		var ri := ULBase.route_info(place)
		cs_seed = int(ri.get("seed", 0))
		cs_start = float(ri.get("start", Time.get_unix_time_from_system()))
		_cs_end = float(ri.end)
		vst = ULBase.visit_load(place)
		cs_resumed = true
	else:
		cs_start = Time.get_unix_time_from_system()
		_cs_end = cs_start + ULBase.minutes_for(place, float(c.get("minutes", 10))) * 60.0
	if test == "" and lvl and ULBase.route_state(place) != "active":
		ULBase.set_route(place, "active")
	if cs_seed == 0:
		cs_seed = 991 if test != "" else int(Time.get_unix_time_from_system() * 1000.0) % 2147483647
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--as-seed=") and not cs_resumed:
			cs_seed = int(a.substr(10))
	if track and not cs_resumed:
		ULBase.route_begin(place, cs_seed, cs_start, _cs_end)
	var rng := RandomNumberGenerator.new()
	rng.seed = cs_seed
	if test == "shbake" or test == "shcheck":
		# запекание теней: запомнить, что стояло до случайной расстановки этого посещения (останки, хлам,
		# находки, враги) — их тень в общую картинку не попадает
		for n in get_tree().root.find_children("*", "GeometryInstance3D", true, false):
			_static_geo[n.get_instance_id()] = true
	zone.place_cows(rng)
	if place == "lair":
		# возвращение в то же логово — тот же экземпляр: ключ главаря и сундук остаются действительными
		lair_inst = String(ULCase.lair().get("inst", "")) if cs_resumed and String(ULCase.lair().get("inst", "")) != "" else ULCase.new_instance()
	if san != null:
		san.roll_containers(rng)
	_spawn_junk(rng)
	# карта проходимости становится доступна через несколько кадров физики (сервер собирает её в фоне);
	# по ней проверяется каждая точка появления
	var map := get_world_3d().navigation_map
	var probe := zone_entry() + Vector3(0, 0, -6)
	for i in 240:
		await get_tree().physics_frame
		if NavigationServer3D.map_get_iteration_id(map) > 0 and NavigationServer3D.map_get_closest_point(map, probe).distance_to(probe) < 1.0:
			break
	var snap := func(p: Vector3) -> Vector3:
		return NavigationServer3D.map_get_closest_point(map, p)
	# кто сейчас на локации — итог перезагрузки кластера (ULReload): по маршруту — тот, что был виден в компьютере
	# базы; без маршрута (тест уровня) — свой розыгрыш. В проверках локаций — прежние промежутки из data
	reload_info = {}
	if ULReload.has_place(place) and (test == "" or test == "reload"):
		if test == "" and not lvl and ULBase.route_state(place) != "":
			reload_info = ULBase.reload_of(place)
		else:
			var rr := RandomNumberGenerator.new()
			for kk in 400:
				rr.seed = hash([cs_seed, "reload", kk])
				reload_info = ULReload.roll(place, rr)
				if test != "reload" or int(reload_info.ruber) > 0:
					break                           # проверка: розыгрыш, где есть и рубер — его тоже надо поставить
		zone.counts = reload_info
	cs_plan = zone.spawn_plan(rng, snap)
	if place == "quarry":
		_ground_reachable(snap)
	var k := 0
	for sp in cs_plan:
		var en := spawn_enemy(String(sp[0]), sp[1])
		en.set_meta("pi", k)                        # номер в расстановке — по нему при возвращении узнаётся, кто убит
		if sp.size() > 2:
			# санаторий: часть стоит на месте, часть бродит; в комнатах — в пределах комнаты
			var outdoor := String(sp[2]) in ["yard", "plaza", "fence", "thicket", "boiler_out", "hozdvor", "behind_main", "road", "camp", "post", "supply", "heli", "tower", "forest", "gate", "admin_yard", "containers", "fuel", "quay", "piers", "tracks", "hangar_yard", "loco_yard", "platforms", "store_yard", "scrap", "field", "apron", "parking", "south", "runway", "taxiway", "north", "west", "cargo_yard"]
			en.wander_r = 0.0 if rng.randf() < 0.4 else (5.0 if outdoor else 1.4)
			if String(sp[0]) == "ruber":
				en.wander_r = 4.0 if outdoor else 2.0           # тяжело бродит на своём месте
			if en is ULMur:
				_mur_role(en as ULMur, String(sp[2]), rng)
		k += 1
		if k % 6 == 0:
			await get_tree().process_frame          # по нескольку за кадр — без долгой заминки на входе
			if not is_inside_tree() or _leaving:
				return                              # ушли с локации, пока она заселялась
	if test == "car" or test == "turfx" or test == "carin":
		ULBase.memory_only = true                  # проверка машины: гараж куплен — в памяти, файл не трогается
		ULBase.load_state(true)
		ULBase.data.garage.level = 1
		ULBase._garage_norm()
	if test == "" or test == "car" or test == "turfx" or test == "carin":
		_car_spawn()
	if not vst.is_empty():
		_cs_restore(vst)
	cs_ready = true
	sn_ready_ms = Time.get_ticks_msec()
	_blobs_build()
	if san != null:
		zone_changed()
	if cs_resumed:
		var lf := int(cs_left())
		say("%s. Вы вернулись: до перезагрузки кластера — %d:%02d" % [zone_name(), lf / 60, lf % 60])
	else:
		say("%s. До перезагрузки кластера — %d минут" % [zone_name(), int(ULBase.minutes_for(place, float(c.get("minutes", 10))))] + (" · ТЕСТ УРОВНЯ: бессмертие, патроны без конца" if lvl else ""))


## Состояние посещения — то, чем локация отличается от только что расставленной по своей случайности: кто из
## расстановки убит (dead — номера), кто ранен (hp), кто появился сверх неё (extra — переродившиеся), что лежит на
## земле (ground — всё целиком: находки, хлам, выброшенное героем), что в тайниках (cont), задание, перерождения.
## Тела убитых не сохраняются (они и так исчезают через минуту) — необысканное с них пропадает.
func cs_state() -> Dictionary:
	var alive := {}
	var hps := {}
	var extra: Array = []
	for e in enemies:
		if not is_instance_valid(e) or not e.alive():
			continue
		if e.has_meta("pi"):
			alive[int(e.get_meta("pi"))] = true
			if e.hp < float(e.def.hp) - 0.5:
				hps[str(int(e.get_meta("pi")))] = snappedf(e.hp, 0.1)
		else:
			extra.append({"k": e.kind, "p": [snappedf(e.global_position.x, 0.01), snappedf(e.global_position.y, 0.01), snappedf(e.global_position.z, 0.01)],
				"hp": snappedf(e.hp, 0.1), "wr": e.wander_r})
	var dead: Array = []
	for i in cs_plan.size():
		if not alive.has(i):
			dead.append(i)
	var gr: Array = []
	for g in ground:
		if g.item == null or not is_instance_valid(g.node):
			continue
		var n: Node3D = g.node
		gr.append({"it": g.item, "p": [snappedf(n.global_position.x, 0.01), snappedf(n.global_position.y, 0.01), snappedf(n.global_position.z, 0.01)], "y": snappedf(n.rotation.y, 0.01)})
	var cont: Array = []
	if san != null:
		for ct in san.containers:
			var items: Array = ct.items
			cont.append(items if items.any(func(x): return x != null) else [])
	return {"v": 1, "seed": cs_seed, "dead": dead, "hp": hps, "extra": extra, "ground": gr, "cont": cont, "quest": quest,
		"evo_n": evo_n, "evo_used": _evo_used.keys()}


## записать состояние посещения (force — сейчас же; иначе не чаще раза в 8 с)
func _cs_state_save(force := false) -> void:
	if not temp() or lvl or not cs_ready or _cs_over or (test != "" and test != "revisit"):
		return
	if ULBase.route_left(place) <= 0:
		return
	var now := Time.get_ticks_msec() * 0.001
	if not force and now - _cs_save_t < 8.0:
		return
	_cs_save_t = now
	ULBase.visit_save(place, cs_state())


static func _v3(a) -> Vector3:
	return Vector3(float(a[0]), float(a[1]), float(a[2])) if a is Array and a.size() >= 3 else Vector3.ZERO


## привести только что расставленную локацию к сохранённому состоянию посещения
func _cs_restore(st: Dictionary) -> void:
	if int(st.get("seed", cs_seed)) != cs_seed:
		return                                     # состояние от другого посещения — не применять
	# на земле — то, что было оставлено
	for g in ground.duplicate():
		_remove_ground(g)
	for r in st.get("ground", []):
		var it = ULInventory._fix(r.get("it"))
		if it != null:
			_spawn_ground(it, _v3(r.get("p")), float(r.get("y", 0.0)))
	# тайники — как были оставлены
	if san != null:
		var cs: Array = st.get("cont", [])
		for i in mini(cs.size(), san.containers.size()):
			var cells := (san.containers[i].items as Array).size()
			var arr: Array = []
			arr.resize(cells)
			var src: Array = cs[i] if cs[i] is Array else []
			for j in mini(src.size(), cells):
				arr[j] = ULInventory._fix(src[j])
			san.containers[i].items = arr
	# враги: убитые не оживают, раненые ранены, переродившиеся — на месте
	var dead := {}
	for d in st.get("dead", []):
		dead[int(d)] = true
	var hps: Dictionary = st.get("hp", {})
	for e in enemies.duplicate():
		if not e.has_meta("pi"):
			continue
		var pi := int(e.get_meta("pi"))
		if dead.has(pi):
			if boss == e:
				boss = null
			targets.erase(e)
			enemies.erase(e)
			e.queue_free()
		elif hps.has(str(pi)):
			e.hp = float(hps[str(pi)])
			e.set_meta("hp", e.hp)
	for x in st.get("extra", []):
		var ne := spawn_enemy(String(x.get("k", "lottery")), _v3(x.get("p")))
		ne.hp = minf(float(x.get("hp", ne.hp)), ne.hp)
		ne.set_meta("hp", ne.hp)
		ne.wander_r = float(x.get("wr", 0.0))
		ne.set_meta("evolved", true)
	var q = st.get("quest", {})
	if q is Dictionary and not (q as Dictionary).is_empty():
		quest = {"found": (q.get("found", {}) as Dictionary).duplicate(), "done": bool(q.get("done", false))}
	evo_n = int(st.get("evo_n", 0))
	for key in st.get("evo_used", []):
		_evo_used[String(key)] = true
	print("[visit] возвращение на «%s»: убитых %d, сверх расстановки %d, на земле %d, осталось %d с" % [place, dead.size(), (st.get("extra", []) as Array).size(), ground.size(), int(cs_left())])


## Находки на земле — только там, куда герой может подойти: лежит вне карты проходимости (у бровки над обрывом,
## под конвейером, за ограждением) — сдвигается на ближайшее место рядом на той же высоте, а если такого нет в 2,5 м —
## убирается (иначе её видно, а поднять нельзя)
func _ground_reachable(snap: Callable) -> void:
	var moved := 0
	var gone: Array = []
	for g in ground.duplicate():
		var n: Node3D = g.node
		var p := n.global_position
		var q: Vector3 = snap.call(p)
		var dh := Vector2(q.x - p.x, q.z - p.z).length()
		if dh <= 0.5 and absf(q.y - p.y) < 0.6:
			continue
		if dh < 2.5 and absf(q.y - p.y) < 0.6:
			n.global_position = Vector3(q.x, q.y + 0.02, q.z)
			moved += 1
		else:
			gone.append("%s %s→%s" % [String(g.item.id), str(p.snapped(Vector3.ONE * 0.1)), str(q.snapped(Vector3.ONE * 0.1))])
			_remove_ground(g)
	print("[quarry] находки на земле: сдвинуто к проходу %d, убрано (не подойти) %d %s" % [moved, gone.size(), str(gone.slice(0, 6))])


## Хлам в постройках временного кластера: в каждой постройке — 2–4 кучки, каждый вход заново (по случайности
## посещения). Кучка — один «Хлам»; подобранные складываются в одну стопку. Новые локации с постройками зовут то же.
func _spawn_junk(rng: RandomNumberGenerator) -> void:
	# ресурсы на полу построек — своим генератором (от случайности посещения): расстановка хлама и врагов
	# от них не сдвигается
	var fr := RandomNumberGenerator.new()
	fr.seed = hash([rng.seed, "floor"])
	if san != null:
		for p in san.junk_points(rng):
			# точка — хлам; [точка, предмет, сколько] — своя находка (минералы у жил и куч руды в карьере)
			if p is Array:
				_spawn_ground(ULItems.make(String(p[1]), int(p[2])), p[0], rng.randf() * TAU)
			else:
				_spawn_ground(ULItems.make("junk"), p, rng.randf() * TAU)
		for p in san.floor_loot(fr):
			_spawn_ground(ULItems.make(String(p[1]), int(p[2])), p[0], fr.randf() * TAU)
		return
	if cowshed == null:
		return
	for i in cowshed.barns.size():
		for k in rng.randi_range(2, 4):
			var p := cowshed.barn_point(i, rng)
			_spawn_ground(ULItems.make("junk"), p, rng.randf() * TAU)
	for p in barn_floor_loot(fr):
		_spawn_ground(ULItems.make(String(p[1]), int(p[2])), p[0], fr.randf() * TAU)


## Ресурсы на полу коровников (у коровника свои постройки, не ULBlock): в каждом — несколько находок по таблице
## floor_loot.barn, сколько — floor_per_barn (data/cowshed.json). Запись: [точка, предмет, сколько, № постройки].
func barn_floor_loot(rng: RandomNumberGenerator) -> Array:
	var out: Array = []
	if cowshed == null:
		return out
	var c := ULCowshed.cfg()
	var tb: Array = (c.get("floor_loot", {}) as Dictionary).get("barn", [])
	if tb.is_empty():
		return out
	var per: Array = c.get("floor_per_barn", [1, 3])
	var sum := 0.0
	for l in tb:
		sum += float(l[3])
	for i in cowshed.barns.size():
		for k in rng.randi_range(int(per[0]), int(per[1])):
			var r := rng.randf() * sum
			var pick: Array = tb[0]
			for l in tb:
				r -= float(l[3])
				if r <= 0.0:
					pick = l
					break
			var p := cowshed.barn_point(i, rng)
			out.append([p + Vector3.UP * 0.02, String(pick[0]), rng.randi_range(int(pick[1]), int(pick[2])), i])
	return out


# ---------------- голод: заражённые растут, пока герой в кластере ----------------
## Время кластера — три стадии (data/evolve.json: stage_at). С 2-й голодные пустыши поблизости от тела (убитого
## врага или останков) идут к нему, садятся и едят feed_s секунд — и перерождаются в лотерейщика; тело съедено.
## В 3-й едят быстрее, ищут дальше, и раз в unseen_every_s секунд один пустыш вдали от героя (которого герой не
## видит) перерождается сам. Всего перерождений за посещение — не больше max_share доли пустышей (от max_min до
## max_max). Заметил героя, услышал выстрел, ранен — бросает еду. Под таймером — «заражённые отъедаются / звереют».
const EVO_CFG := "res://data/evolve.json"
var evo := {}
var evo_n := 0                       ## сколько переродилось в это посещение
var evo_max := 0
var _evo_stage := 0
var _evo_pulse := 0.0
var _evo_unseen := -1.0
var _evo_taken := {}                 ## еда → кто её ест: тело врага (id тела) или останки («r<номер>») → id едока
var _evo_used := {}                  ## съеденные останки
var _evo_rng := RandomNumberGenerator.new()


func evo_cfg() -> Dictionary:
	if evo.is_empty():
		var d = JSON.parse_string(FileAccess.get_file_as_string(EVO_CFG))
		evo = d if d is Dictionary else {"stage_at": [0.3, 0.6]}
	return evo


## стадия голода: 0 — не временный кластер, 1 — сытые, 2 — отъедаются, 3 — звереют
func evo_stage() -> int:
	if not temp() or _cs_end <= 0.0 or cs_start <= 0.0:
		return 0
	var fr := clampf(1.0 - cs_left() / maxf(_cs_end - cs_start, 1.0), 0.0, 1.0)
	var sa: Array = evo_cfg().get("stage_at", [0.3, 0.6])
	return 1 if fr < float(sa[0]) else (2 if fr < float(sa[1]) else 3)


func _evo_tick(delta: float) -> void:
	var st := evo_stage()
	if st != _evo_stage:
		var was := _evo_stage
		_evo_stage = st
		_grade_apply()
		if was > 0 and st == 2:
			say("Заражённые проголодались: едят тела и перерождаются")
		elif was > 0 and st == 3:
			say("Заражённые звереют: перерождаются и без тел")
		if st == 3:
			_evo_unseen = float(evo_cfg().get("unseen_every_s", 70.0)) * 0.5
	if st < 2:
		return
	var c := evo_cfg()
	var si := st - 2
	var from := String(c.get("from", "infected"))
	if evo_max <= 0:
		var n := 0
		for e in enemies:
			if e.kind == from:
				n += 1
		evo_max = clampi(roundi(float(n) * float(c.get("max_share", 0.35))), int(c.get("max_min", 3)), int(c.get("max_max", 12)))
		_evo_rng.seed = hash([cs_seed, "evo"])
	# едоки: наелся — перерождается; бросил еду — она свободна; тело, которое едят, не исчезает
	var feeding := 0
	for e in enemies.duplicate():
		if e.alive() and e.state == "feed":
			if e.fed:
				_evolve(e, true)
			else:
				feeding += 1
	for key in _evo_taken.keys():
		var fe = instance_from_id(int(_evo_taken[key]))
		if fe == null or not is_instance_valid(fe) or not (fe as ULEnemy).alive() or (fe as ULEnemy).state != "feed":
			_evo_taken.erase(key)
		elif key is int:
			var body = instance_from_id(int(key))
			if body != null and is_instance_valid(body) and not (body as ULEnemy).alive():
				(body as ULEnemy).dead_t = minf((body as ULEnemy).dead_t, ULEnemy.CORPSE_S - 15.0)
	_evo_pulse -= delta
	if _evo_pulse <= 0.0:
		_evo_pulse = float((c.get("pulse_s", [14.0, 9.0]) as Array)[si])
		_evo_feeders(si, feeding)
	if st >= 3:
		_evo_unseen -= delta
		if _evo_unseen <= 0.0:
			_evo_unseen = float(c.get("unseen_every_s", 70.0))
			if evo_n + feeding < evo_max:
				var cand: Array = []
				for e in enemies:
					if e.alive() and e.kind == from and (e.state == "idle" or e.state == "wander") \
							and e.global_position.distance_to(player.global_position) > float(c.get("unseen_min_d", 45.0)) and not bool(e.get_meta("sees", false)):
						cand.append(e)
				if not cand.is_empty():
					_evolve(cand[_evo_rng.randi() % cand.size()], false)


## отправить голодных к свободной еде (тела убитых и останки локации)
func _evo_feeders(si: int, feeding: int) -> void:
	var c := evo_cfg()
	var from := String(c.get("from", "infected"))
	var want := int((c.get("feeders", [1, 2]) as Array)[si])
	var r := float((c.get("feed_r", [24.0, 34.0]) as Array)[si])
	var food: Array = []
	for e in enemies:
		if not e.alive() and e.dead_t < ULEnemy.CORPSE_S - 12.0 and not _evo_taken.has(e.get_instance_id()):
			food.append([e.body_pos(), e.get_instance_id()])
	if zone != null and "cows" in zone:
		for i in (zone.cows as Array).size():
			var key := "r%d" % i
			if not _evo_taken.has(key) and not _evo_used.has(key):
				food.append([zone.cows[i], key])
	for i in range(food.size() - 1, 0, -1):
		var j := _evo_rng.randi_range(0, i)
		var tmp = food[i]
		food[i] = food[j]
		food[j] = tmp
	var started := 0
	for f in food:
		if started >= want or evo_n + feeding + started >= evo_max:
			break
		var fp: Vector3 = f[0]
		var best: ULEnemy = null
		var bd := r
		for e in enemies:
			if e.alive() and e.kind == from and (e.state == "idle" or e.state == "wander") and absf(e.global_position.y - fp.y) < 1.6:
				var d := e.global_position.distance_to(fp)
				if d < bd:
					best = e
					bd = d
		if best != null:
			best.start_feed(fp, float((c.get("feed_s", [22.0, 14.0]) as Array)[si]))
			best.set_meta("evo_food", f[1])
			_evo_taken[f[1]] = best.get_instance_id()
			started += 1


## переродить пустыша в лотерейщика на том же месте; seen — на глазах (крик, кровь, сообщение рядом с героем)
func _evolve(e: ULEnemy, seen: bool) -> ULEnemy:
	var c := evo_cfg()
	var at := e.global_position
	if e.has_meta("evo_food"):
		var key = e.get_meta("evo_food")
		_evo_taken.erase(key)
		if key is int:
			var body = instance_from_id(int(key))
			if body != null and is_instance_valid(body) and not (body as ULEnemy).alive():
				(body as ULEnemy).dead_t = ULEnemy.CORPSE_S             # съеден — исчезает в этот же кадр
		else:
			_evo_used[key] = true
	var ne := spawn_enemy(String(c.get("into", "lottery")), at)
	ne.rotation.y = e.rotation.y
	ne.home = e.home
	ne.wander_r = e.wander_r
	ne.set_meta("evolved", true)
	if _evo_rng.randf() < float(c.get("pearl", 0.0)):
		ULInventory.put(ne.loot, ULItems.make("pearl_black", 1))
	if _mark_t == e:
		_mark_t = null
	targets.erase(e)
	enemies.erase(e)
	_dmg_lb.erase(e)
	e.queue_free()
	evo_n += 1
	if seen:
		_blood(at + Vector3.UP * 0.9, Vector3.UP, 18)
		if ne.rig.has_clip("scream"):
			ne.rig.play("scream")
		_enemy_noise("roar", at, ne)
		if at.distance_to(player.global_position) < 26.0:
			say("Пустыш отъелся и переродился в лотерейщика")
	return ne


## сколько секунд осталось до перезагрузки кластера
func cs_left() -> float:
	return maxf(_cs_end - Time.get_unix_time_from_system(), 0.0) if _cs_end > 0.0 else 0.0


static func _minutes_text(sec: int) -> String:
	var m := sec / 60
	return "%d %s" % [m, ["минута", "минуты", "минут"][ULEconomy.plural_form(m)]]


func _cs_tick(delta: float) -> void:
	if zone:
		zone.tick(player.global_position, cam, delta)
	if _cs_done or _cs_end <= 0.0:
		return
	if not quest_stages().is_empty():
		_quest_t -= delta
		if _quest_t <= 0.0:
			_quest_t = 0.4
			quest_tick()
	if cs_ready and _dead_t <= 0.0 and (test == "" or test == "evo"):
		_evo_tick(delta)
	# состояние посещения пишется раз в 20 с: если игру закроют, при возвращении локация будет как оставлена
	_cs_auto += delta
	if _cs_auto >= 20.0:
		_cs_auto = 0.0
		_cs_state_save()
	var left := cs_left()
	var c := zone_cfg()
	for wv in c.get("warn_s", [300, 120]):
		var ws := int(wv)
		if left <= ws and not _cs_warned.has(ws):
			_cs_warned[ws] = true
			if left > ws - 5.0:
				say("Внимание! До перезагрузки кластера %s" % _minutes_text(ws))
				snd.play("beep", player.global_position + Vector3.UP, 0.0, 0.0)
	if left <= float(c.get("alarm_s", 30)) and left > 0.0:
		_cs_alarm -= delta
		if _cs_alarm <= 0.0:
			_cs_alarm = 2.2
			snd.play("alarm", player.global_position + Vector3.UP * 2.0, -4.0, 0.0)
			if not _cs_warned.has(-1):
				_cs_warned[-1] = true
				say("ТРЕВОГА! Кластер перезагружается — уходите за край поля!")
	if left <= 0.0 and lvl:
		# тест уровня: кластер не убивает — таймер просто начинается заново
		_cs_end = Time.get_unix_time_from_system() + ULBase.minutes_for(place, float(c.get("minutes", 10))) * 60.0
		_cs_warned.clear()
		say("Тест уровня: таймер кластера начат заново")
		return
	if left <= 0.0 and not _cs_over:
		_cs_over = true
		say("Кластер перезагружается!")
		if _dead_t <= 0.0:
			hp = 0.0
			_dead_t = 3.0
			_hero_fall()
			close_inventory()
			_hud_touch.clear()
			_joy_id = -1
			_joy_v = Vector2.ZERO


## Задание «Последняя смена»: находка засчитывается, когда предмет попал в инвентарь (поднят с земли или взят из
## тайника); выброшенный потом — всё равно засчитан. Этапы: три следа рабочих, журнал диспетчера, ящик с
## образцами, выход до перезагрузки (награда — data/quarry.json, quest.reward; только при выходе за край).
func quest_stages() -> Array:
	return QUEST_SETS.get(place, [])


func quest_cfg() -> Dictionary:
	return zone_cfg().get("quest", {})


func quest_tick() -> void:
	if quest.is_empty():
		quest = {"found": {}, "done": false}
	var found: Dictionary = quest.found
	if place == "airport" and san != null:
		# этапы без предмета: вышел к посадочному выходу рейса (узнав о нём), поднялся в самолёт рейса
		var ap := san as ULAirport
		if found.has("a_flight") and not found.has("a_gate") and player.global_position.distance_to(ap.gate_pt) < 9.0:
			found["a_gate"] = true
			say("Задание «%s»: посадочный выход № 2 найден — самолёт рейса на стоянке перед ним" % String(quest_cfg().get("n", "")))
		if not found.has("a_plane") and ap.flight_plane >= 0 and ap.plane_at(player.global_position) == ap.flight_plane:
			found["a_plane"] = true
			say("Задание «%s»: вы в самолёте рейса 417. Груз — в хвостовом отсеке" % String(quest_cfg().get("n", "")))
	for st in quest_stages():
		for id in st[2]:
			if not found.has(id) and ULItems.ITEMS.has(String(id)) and inv.count(String(id)) > 0:
				found[id] = true
				say("Задание «%s»: %s — %s" % [String(quest_cfg().get("n", "")), ULItems.title({"id": id, "n": 1}), quest_line(String(st[0]))])


## сколько найдено по этапу и всего
func quest_progress(stage: String) -> Vector2i:
	for st in quest_stages():
		if String(st[0]) == stage:
			var n := 0
			for id in st[2]:
				if (quest.get("found", {}) as Dictionary).has(id):
					n += 1
			return Vector2i(n, (st[2] as Array).size())
	return Vector2i.ZERO


func quest_ready() -> bool:
	for st in quest_stages():
		var pr := quest_progress(String(st[0]))
		if pr.y > 0 and pr.x < pr.y:
			return false
	return true


func quest_line(stage: String) -> String:
	var pr := quest_progress(stage)
	return "%d/%d" % [pr.x, pr.y] if pr.y > 1 else ("найден" if pr.x > 0 else "не найден")


## панель задания слева под строкой состояния: этапы и отметки
func _quest_hud(vs: Vector2, font0: Font) -> void:
	if quest_stages().is_empty() or _cs_end <= 0.0:
		return
	var q: Dictionary = quest_cfg()
	var x := 12.0
	var y := 124.0                                # под строкой состояния (имя, ресурсы, место и кадры/с)
	var lines: Array = []
	var cur_set := false
	for st in quest_stages():
		var pr := quest_progress(String(st[0]))
		var ok := pr.y > 0 and pr.x >= pr.y
		var cur := not ok and not cur_set
		if cur:
			cur_set = true
		var txt := String(st[1]) + ((" " + quest_line(String(st[0]))) if pr.y > 1 else "")
		lines.append([("✓ " if ok else ("▸ " if cur else "• ")) + txt, Color(0.55, 0.9, 0.55) if ok else (Color(1.0, 0.85, 0.45) if cur else Color(0.8, 0.8, 0.76))])
	var w := 330.0
	_hud.draw_rect(Rect2(x - 6, y - 22, w, 26 + lines.size() * 22), Color(0.04, 0.03, 0.02, 0.55))
	_hud.draw_string(font0, Vector2(x, y), "Задание: " + String(q.get("n", "Последняя смена")), HORIZONTAL_ALIGNMENT_LEFT, -1, 17, Color(1.0, 0.86, 0.5))
	for i in lines.size():
		_hud.draw_string(font0, Vector2(x + 4, y + 22 + i * 22), String(lines[i][0]), HORIZONTAL_ALIGNMENT_LEFT, -1, 15, lines[i][1])


## Конец посещения: left — ушёл за край (вещи при себе), menu — вышел в главное меню, reset — кластер
## перезагрузился с героем внутри, dead — погиб. В двух последних случаях всё, что при себе, теряется
## (data/cowshed.json: lose_on_death, lose_wallet). Маршрут закрывается — локация пропадает с карты.
func cs_finish(why: String) -> void:
	if _cs_done:
		return
	_cs_done = true
	if lvl:
		_lvl_exit()
		return
	var c := zone_cfg()
	if why == "reset" or (why == "dead" and bool(c.get("lose_on_death", true))):
		var keep: Dictionary = {} if bool(c.get("lose_wallet", true)) else inv.wallet.duplicate()
		inv.from_dict({"wallet": keep})
		hp = 50.0
	# задание карьера: всё найдено и ушёл до перезагрузки — награда в кошелёк (до записи того, что при себе)
	var quest_note := ""
	# награда — только за выход из кластера с выполненными этапами (в порту — с особым грузом при себе)
	if not quest_stages().is_empty() and why == "left" and not quest.is_empty() and quest_ready() and not bool(quest.get("done", false)) \
			and (not QUEST_CARRY.has(place) or inv.count(String(QUEST_CARRY[place])) > 0):
		quest.done = true
		var rw: Dictionary = quest_cfg().get("reward", {})
		for k in rw:
			inv.wallet[k] = int(inv.wallet.get(k, 0)) + int(rw[k])
		quest_note = "\nЗадание «%s» выполнено: " % String(quest_cfg().get("n", "")) + ULEconomy.list_text(rw) + "."
	_save_carried()
	# Локация остаётся на карте, пока не вышло её время (кроме перезагрузки кластера): состояние посещения
	# записывается — при возвращении всё будет как оставлено.
	var lf := ULBase.route_left(place)
	var keep := why != "reset" and lf > 0 and ULBase.route_keep(why) and cs_ready
	var note := String(CS_NOTES.get(why, ""))
	if keep:
		_cs_state_save(true)
		note = String(CS_NOTES_KEEP.get(why, note))
		note = note % [zone_name(), "%d:%02d" % [lf / 60, lf % 60]] if note.count("%s") == 2 else note
	else:
		ULBase.set_route(place, "")
		note = note % zone_name() if note.contains("%s") else note
	ULSettings.place = "home"
	ULSettings.arrival_note = note + quest_note
	ULSettings.arrival_title = zone_name()
	if test == "":
		_leave_to({"left": "res://map.tscn", "menu": "res://menu.tscn"}.get(why, "res://world.tscn"), "выход с локации %s (%s)" % [place, why])


## По чему идёт герой — такой и звук шага: земля («step»), бетон (бункер, гараж, плита, корпуса), доски (избы и
## сараи Хутора), металл (помост гаража). Звуки свои, синтезированные: tools/make_sfx.py.
func _step_surface() -> String:
	var p := player.global_position
	if place == "home":
		if garage != null:
			var l := garage.to_local(p)
			if garage.built and absf(l.x) < ULGarage.PLAT.x * 0.5 + ULGarage.SIDE and absf(l.z - ULGarage.PLAT_Z) < ULGarage.PLAT.z * 0.5 + ULGarage.RAMP:
				return "step_metal"
			if absf(l.x) < ULGarage.W * 0.5 + 0.3 and absf(l.z) < ULGarage.D * 0.5 + 0.3:
				return "step_concrete"
		return "step_concrete" if _in_house(p) else "step"
	if san != null and san.hero_b >= 0 and san.hero_b < san.blds.size():
		var st := String(san.blds[san.hero_b].style)
		return "step_wood" if st == "wood" else ("step" if st == "tent" or st == "cellar" else "step_concrete")
	return "step"


func _door_sound(at: Vector3, opened: bool) -> void:
	if snd != null and is_inside_tree() and (cs_ready or not temp()) and at.distance_to(player.global_position) < 14.0:
		snd.play("door_creak", at + Vector3.UP, -9.0 if opened else -13.0, 0.1)


