## Снимки «как выглядит» (--as-place=…, --as-grade=1, --as-rain=0/1, --as-at=x,z): общий вид у входа, тело с
## мухами рядом с героем; печатает средний цвет кадра (сравнение до/после цветокоррекции)
func _look_test() -> void:
	var t0 := Time.get_ticks_msec()
	while temp() and not cs_ready and Time.get_ticks_msec() - t0 < 20000:
		await get_tree().process_frame
	hp_lock = true
	hero_unseen = true
	var at := zone_entry() + Vector3(0, 0.05, -14.0) if temp() else player.global_position
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--as-at="):
			var xz := a.substr(8).split(",")
			at = Vector3(float(xz[0]), 0.05, float(xz[1]))
	if "--as-in=1" in OS.get_cmdline_user_args() and san != null and not san.blds.is_empty():
		# внутри: самая большая комната первого этажа первого корпуса с окнами
		var best = null
		var bb: ULBlock = null
		for b in san.blds:
			for r in (b as ULBlock).rooms:
				if int(r.f) == 0 and String(r.type) != "cor" and String(r.type) != "stair" and int(r.get("side", 0)) != 0:
					var area := (float(r.u1) - float(r.u0)) * (float(r.v1) - float(r.v0))
					if best == null or area > float(best.area):
						best = {"r": r, "area": area}
						bb = b
			if best != null:
				break
		var r = best.r
		var bk: Dictionary = bb.blocks[int(r.bi)]
		at = bb._w(bk, (float(r.u0) + float(r.u1)) * 0.5, 0.05, (float(r.v0) + float(r.v1)) * 0.5)
		await get_tree().create_timer(1.5).timeout
		print("[look] свет этажей у корпуса: %d" % bb.light_floors)
	player.global_position = at
	_cam_ready = false
	var e := spawn_enemy("infected", at + Vector3(2.5, 0, -1.5))
	await get_tree().create_timer(0.5).timeout
	e.damage(9999.0)
	e.dead_t = 5.0
	await get_tree().create_timer(2.5).timeout
	var tag := "%s_g%d_r%d" % [place, int(grade_on()), int(weather_rain)]
	await _snap("look_" + tag)
	await RenderingServer.frame_post_draw
	var img := get_viewport().get_texture().get_image()
	img.resize(64, 36)
	var m := Vector3.ZERO
	for y in 36:
		for x in 64:
			var c := img.get_pixel(x, y)
			m += Vector3(c.r, c.g, c.b)
	m /= 64.0 * 36.0
	print("[look] %s: средний цвет %.3f %.3f %.3f · мух %d · дождь %s" % [tag, m.x, m.y, m.z, weather.flies_shown, str(weather_rain)])
	_test_done()


## Следы боя: дырки от пуль в стене (с пылью), брызги крови на стене за раненым, лужа под телом растекается
func _traces_test() -> void:
	await get_tree().create_timer(0.6).timeout
	var t0 := Time.get_ticks_msec()
	while temp() and not cs_ready and Time.get_ticks_msec() - t0 < 20000:
		await get_tree().process_frame
	if temp():
		# у первой постройки: герой в 6 м от её середины, со стороны камеры (юг)
		var b0: Node3D = (zone.barns[0] as Dictionary).node
		player.global_position = b0.global_position + Vector3(0, 0.05, 9.0)
		await get_tree().create_timer(0.5).timeout
	hp_lock = true
	hero_unseen = true
	var p0 := player.global_position + Vector3.UP * 1.2
	var wall := {}
	var wd := Vector3.ZERO
	for k in 16:
		var d := Vector3(cos(k * TAU / 16.0), 0, sin(k * TAU / 16.0))
		var h := _ray_static(p0, p0 + d * 12.0)
		if not h.is_empty() and absf((h.normal as Vector3).y) < 0.3 and (wall.is_empty() or p0.distance_to(h.position) < p0.distance_to(wall.position)):
			wall = h
			wd = d
	_ok("рядом есть стена для проверки", not wall.is_empty())
	if wall.is_empty():
		_test_done()
		return
	var wp: Vector3 = wall.position
	var n: Vector3 = wall.normal
	print("[traces] стена: %s, нормаль %s, кто: %s (%s)" % [str(wp), str(n), str(wall.collider), (wall.collider as Node).get_path() if wall.collider is Node else ""])
	# герой — в 3,5 м от стены лицом к ней
	player.global_position = Vector3(wp.x, player.global_position.y, wp.z) + Vector3(n.x, 0, n.z).normalized() * 3.5
	_cam_ready = false
	await get_tree().create_timer(0.4).timeout
	var side := Vector3(-n.z, 0, n.x).normalized()
	var m0 := marks_made
	for i in 5:
		var tgt := wp + side * (i - 2) * 0.35 + Vector3.UP * (0.1 * (i % 2))
		_bullet_hole(tgt + n * 3.0, tgt)
	_ok("5 выстрелов в стену — 5 дырок", marks_made - m0 == 5, str(marks_made - m0))
	var m1 := marks_made
	_wall_splat(wp + n * 0.8 + side * 0.9 + Vector3.UP * 0.1, -n)
	_ok("раненый у стены — брызги крови на стене за ним", marks_made - m1 == 1)
	_bullet_hole(player.global_position + Vector3.UP * 1.2, player.global_position + Vector3(0.3, -1.0, 0.2))
	_ok("в пол дырки нет", marks_made - m1 == 1)
	var e := spawn_enemy("infected", player.global_position + side * 1.6 + Vector3(n.x, 0, n.z) * -0.6)
	await get_tree().create_timer(0.3).timeout
	var p1 := pools_made
	e.damage(9999.0)
	# тело падает на физике: лужа — когда легло (там, где легло)
	var tp0 := Time.get_ticks_msec()
	while Time.get_ticks_msec() - tp0 < 8000 and pools_made - p1 < 1:
		await get_tree().process_frame
	_ok("под убитым — лужа крови", pools_made - p1 == 1)
	await get_tree().create_timer(6.0).timeout
	await _snap("traces")
	_test_done()


func _test_done() -> void:
	print("[inv] итог: ошибок %d" % _fails)
	get_tree().quit()


## голод заражённых (коровник): стадии по времени, едок идёт к телу, ест (поза, чавканье), перерождается
## в лотерейщика — тело съедено; прерывание раной и взглядом героя; предел перерождений; в 3-й стадии — без тел
func _evo_test() -> void:
	var t0 := Time.get_ticks_msec()
	while not cs_ready and Time.get_ticks_msec() - t0 < 15000:
		await get_tree().process_frame
	hp_lock = true
	hero_unseen = true
	if not cs_ready or zone == null or not temp():
		_ok("локация с голодом (временный кластер) загрузилась", false, place)
		_test_done()
		return
	var c := evo_cfg()
	var dur := 600.0
	var set_frac := func(fr: float) -> void:
		var now := Time.get_unix_time_from_system()
		cs_start = now - dur * fr
		_cs_end = cs_start + dur
	set_frac.call(0.05)
	for i in 30:
		await get_tree().process_frame
	var feeding0 := 0
	for e in enemies:
		if e.state == "feed":
			feeding0 += 1
	_ok("в начале посещения заражённые сыты: стадия 1, к телам никто не идёт", evo_stage() == 1 and feeding0 == 0 and evo_n == 0)
	# тело рядом со спокойным пустышом; останки коров на время — «съедены», чтобы еда была одна
	var a: ULEnemy = null
	var b: ULEnemy = null
	var bd := 99.0
	for e1 in enemies:
		if e1.kind != "infected" or not (e1.state == "idle" or e1.state == "wander"):
			continue
		for e2 in enemies:
			if e2 != e1 and e2.kind == "infected" and absf(e2.global_position.y - e1.global_position.y) < 1.0:
				var d := e1.global_position.distance_to(e2.global_position)
				if d > 3.0 and d < bd:
					bd = d
					a = e1
					b = e2
	if "cows" in zone:
		for i in (zone.cows as Array).size():
			_evo_used["r%d" % i] = true
	_ok("есть пара пустышей для проверки (%.1f м)" % bd, a != null and b != null and bd < float((c.feed_r as Array)[0]))
	if a == null:
		_test_done()
		return
	var body_at := b.body_pos()
	b.damage(9999.0)
	# остальные пустыши — далеко от тела не помешают: едок — ближайший спокойный
	set_frac.call(0.45)
	_evo_pulse = 0.0
	var fe: ULEnemy = null
	for i in 90:
		await get_tree().process_frame
		for e in enemies:
			if e.alive() and e.state == "feed":
				fe = e
		if fe != null:
			break
	_ok("2-я стадия (%.0f %% времени): голодный пустыш пошёл к телу" % 45.0, evo_stage() == 2 and fe != null and fe.kind == "infected" and fe.feed_at.distance_to(body_at) < 0.5)
	if fe == null:
		_test_done()
		return
	_ok("тело, к которому идут, занято одним едоком", _evo_taken.size() == 1 and _evo_taken.has(b.get_instance_id()))
	# быстрее: ставим едока к телу и укорачиваем трапезу
	fe.global_position = fe.feed_at + Vector3(0.6, 0.0, 0.0)
	fe.feed_need = 2.5
	var fe_id := fe.get_instance_id()
	var fe_at := fe.global_position
	var posed := false
	var chewed := false
	var clip_ok := false
	b.dead_t = ULEnemy.CORPSE_S - 5.0                    # тело почти исчезло — пока его едят, оно лежит
	var t1 := Time.get_ticks_msec()
	while is_instance_valid(fe) and Time.get_ticks_msec() - t1 < 8000:
		await get_tree().process_frame
		if is_instance_valid(fe) and fe._feeding:
			posed = true
			clip_ok = fe.rig.has_clip("infected_feed")
			chewed = chewed or fe.feed_t > 0.5
			if fe.feed_t > 1.2 and not has_meta("evo_snap"):
				# снимок: герой встаёт в 3 м от едока (его не замечают), камера — за героем
				set_meta("evo_snap", true)
				var hp0 := player.global_position
				player.global_position = fe.global_position + Vector3(-2.2, 0.05, 2.2)
				for k in 6:
					await get_tree().process_frame
				await _snap("evo_feed")
				if is_instance_valid(fe):
					print("[evo] поза едока: %s вес %.2f" % [fe.rig._pose, fe.rig._pose_w])
				player.global_position = hp0
	_ok("едок сел у тела и ел (поза «infected_feed» есть у пустыша, время трапезы шло)", posed and chewed and clip_ok)
	var ne: ULEnemy = null
	for e in enemies:
		if e.alive() and e.kind == "lottery" and e.has_meta("evolved"):
			ne = e
	_ok("наевшись — переродился в лотерейщика на том же месте, пустыш убран", not is_instance_valid(instance_from_id(fe_id)) and ne != null and ne.global_position.distance_to(fe_at) < 2.0 and evo_n == 1)
	await get_tree().process_frame
	_ok("тело съедено — его больше нет", not is_instance_valid(b) or not enemies.has(b))
	_ok("еда освобождена, счёт перерождений 1 из %d" % evo_max, _evo_taken.is_empty() and evo_max >= int(c.max_min) and evo_max <= int(c.max_max))
	# прерывание: ранен — бросает еду
	var k2: ULEnemy = null
	for e in enemies:
		if e.alive() and e.kind == "infected" and (e.state == "idle" or e.state == "wander"):
			k2 = e
			break
	k2.start_feed(k2.global_position + Vector3(3, 0, 0), 20.0)
	k2.damage(1.0, player.global_position)
	_ok("ранен во время еды — бросил еду", k2.state != "feed" and k2.feed_at == Vector3.INF)
	# прерывание: увидел героя
	var k3: ULEnemy = null
	for e in enemies:
		if e.alive() and e.kind == "infected" and (e.state == "idle" or e.state == "wander") and e != k2:
			k3 = e
			break
	k3.start_feed(k3.global_position + Vector3(0.3, 0, 0), 20.0)
	k3.tick(0.02, k3.global_position + Vector3(4, 0, 0), true, true)
	_ok("увидел героя во время еды — бросил еду и заметил его", k3.state != "feed" and (k3.state == "alert" or k3.state == "chase"), k3.state)
	# предел
	var n_was := evo_n
	evo_n = evo_max
	for e in enemies:
		if e.state == "feed":
			e.end_feed()
	_evo_taken.clear()
	_evo_used.clear()
	_evo_feeders(1, 0)
	var fd := 0
	for e in enemies:
		if e.state == "feed":
			fd += 1
	_ok("на пределе (%d) новые едоки не идут" % evo_max, fd == 0)
	evo_n = n_was
	# 3-я стадия: далёкий пустыш, которого герой не видит, перерождается сам (с жемчужиной — проверка шанса)
	set_frac.call(0.75)
	for i in 3:
		await get_tree().process_frame                  # смена стадии ставит свой отсчёт — ждём её
	_evo_unseen = 0.01
	var pearl0 := float(evo.get("pearl", 0.0))
	evo["pearl"] = 1.0
	var n3 := evo_n
	for i in 20:
		await get_tree().process_frame
	evo["pearl"] = pearl0
	var far: ULEnemy = null
	for e in enemies:
		if e.alive() and e.has_meta("evolved") and e != ne:
			far = e
	var pearl := false
	if far != null:
		for it in far.loot:
			if it != null and String(it.id) == "pearl_black":
				pearl = true
	_ok("3-я стадия: вдали (дальше %d м) пустыш переродился сам, в нём чёрная жемчужина (шанс %.0f %% — тут поднят до 100)" % [int(c.unseen_min_d), float(evo_cfg().get("pearl", 0.0)) * 100.0], evo_stage() == 3 and evo_n == n3 + 1 and far != null and far.global_position.distance_to(player.global_position) > float(c.unseen_min_d) and pearl)
	# надпись под таймером
	_hud.queue_redraw()
	await get_tree().process_frame
	await _snap("evo_hud")
	print("[evo] переродилось %d из %d" % [evo_n, evo_max])
	_test_done()


## дары: жемчужина будит и растит дары (ступени по цвету, предел 3 дара × 3 уровня), действие каждого дара,
