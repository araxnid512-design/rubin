				var ex := hw + 0.34
				var ez := hd + 0.34
				if l0.x < ex and l1.x > -ex and l0.z < ez and l1.z > -ez:
					poke = minf(minf(ex - l0.x, l1.x + ex), minf(ez - l0.z, l1.z + ez))
